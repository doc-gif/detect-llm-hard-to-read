    "code": " def my_get_ans(n, pos, l, r):\n\n    if l == 1 and r == n:\n\n        return 0\n\n    if l == 1 and r != n:\n\n        return abs(pos - r) + 1\n\n    if l != 1 and r == n:\n\n        return abs(pos - l) + 1\n\n    if l <= pos <= r:\n\n        return r - l + 2 + min(abs(pos - l), abs(pos - r))\n\n    if pos < l:\n\n        return r - l + 2 + abs(pos - l)\n\n    return r - l + 2 + abs(pos - r)\n\nprint(my_get_ans(*map(int, input().split())))",
