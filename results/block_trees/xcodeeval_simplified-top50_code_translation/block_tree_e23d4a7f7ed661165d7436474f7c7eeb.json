    "code": " n, m = map(int, input().split())\n\nedges = [[] for _ in range(n)]\n\nfor _ in range(m):\n\n    a, b = map(int, input().split())\n\n    a, b = a - 1, b - 1\n\n    edges[a].append(b)\n\n    edges[b].append(a)\n\nif n <= 6:\n\n    print(m)\n\nelse:\n\n    intersections = []\n\n    for i in range(n):\n\n        for j in range(i):\n\n            common = set(edges[i]) & set(edges[j])\n\n            intersections.append(common)\n\n    common_counts = [len(s) for s in intersections]\n\n    print(m - min(common_counts))",
