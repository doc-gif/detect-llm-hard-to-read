    "code": " n, budget = map(int, input().split())\n\nnumbers = list(map(int, input().split()))\n\neven_count = 0\n\nodd_count = 0\n\ncuts = []\n\ncurrent_sum = 0\n\nanswer = 0\n\nfor i in range(n):\n\n    if numbers[i] % 2:\n\n        odd_count += 1\n\n    else:\n\n        even_count += 1\n\n    if even_count == odd_count and i < n - 1:\n\n        cuts.append(abs(numbers[i + 1] - numbers[i]))\n\n        even_count = 0\n\n        odd_count = 0\n\ncuts.sort()\n\nfor cost in cuts:\n\n    answer += 1\n\n    current_sum += cost\n\n    if current_sum > budget:\n\n        answer -= 1\n\n        print(answer)\n\n        exit(0)\n\nprint(answer)",
