    "code": " def main():\n\n    height, node = read()\n\n    node -= 1\n\n    binary = bin(node)[2:].zfill(height)\n\n    path = \"\"\n\n    for i in range(height):\n\n        if i > 0 and binary[i - 1] == \"0\":\n\n            path += \"1\" if binary[i] == \"0\" else \"0\"\n\n        else:\n\n            path += binary[i]\n\n    steps = 0\n\n    for i in range(height):\n\n        steps += 1\n\n        if path[i] == \"1\":\n\n            steps += (1 << (height - i)) - 1\n\n    print(steps)\n\ndef read(mode=2):\n\n    inputs = input().strip()\n\n    if mode == 0:\n\n        return inputs\n\n    if mode == 1:\n\n        return inputs.split()\n\n    if mode == 2:\n\n        return list(map(int, inputs.split()))\n\ndef write(s=\"\\n\"):\n\n    if s is None:\n\n        s = \"\"\n\n    if isinstance(s, list):\n\n        s = \" \".join(map(str, s))\n\n    print(s, end=\"\")\n\nwrite(main())",
