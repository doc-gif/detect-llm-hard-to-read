    "code": " def binary_search(n, k, low, high):\n\n    while low <= high:\n\n        mid = (high + low) // 2\n\n        total = ((k * (k + 1)) // 2 - 1) - (((mid - 1) * mid) // 2 - 1) - (k - 2)\n\n        if total == n:\n\n            return k - mid + 1\n\n        if total > n:\n\n            low = mid + 1\n\n        elif total < n:\n\n            high = mid - 1\n\n    if total > n:\n\n        mid += 1\n\n    return k - mid + 1\n\ndef solve():\n\n    n, k = map(int, input().split())\n\n    if n == 1:\n\n        return 0\n\n    if (k * (k + 1) // 2) - (k - 2) <= n:\n\n        return -1\n\n    if k >= n:\n\n        return 1\n\n    return binary_search(n, k, 2, k)\n\nprint(solve())",
