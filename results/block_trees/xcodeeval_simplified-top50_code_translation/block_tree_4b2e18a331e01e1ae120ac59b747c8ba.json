    "code": " import math\n\ndef find(n, k, length):\n\n    if k < n:\n\n        return [k]\n\n    max_val = 0\n\n    index = 1\n\n    for i in range(1, length + 1):\n\n        temp = k % (10**i)\n\n        if temp >= n:\n\n            break\n\n        if temp >= 10 ** (i - 1):\n\n            max_val = temp\n\n            index = i\n\n    remainder = k - max_val\n\n    remainder = remainder // (10**index)\n\n    return find(n, remainder, length) + [max_val]\n\nn = int(input())\n\nk = int(input())\n\nlength = int(math.log(n - 1, 10)) + 1\n\nANS = find(n, k, length)[::-1]\n\nans = 0\n\ntemp = 1\n\nfor i in range(len(ANS)):\n\n    ans += ANS[i] * temp\n\n    temp *= n\n\nprint(ans)",
