    "code": " def sum_digit(num):\n\n    total = 0\n\n    while num > 0:\n\n        digit = num % 10\n\n        total += digit\n\n        num //= 10\n\n    return total\n\ninput_str = input()\n\nn = int(input_str)\n\nstr_n = str(n)\n\nif len(str_n) > 1:\n\n    first_digit = str(int(str_n[0]) - 1)\n\n    if first_digit == \"0\":\n\n        first_digit = \"\"\n\n    n1_str = first_digit + \"9\" * (len(str_n) - 1)\n\n    x = int(n1_str)\n\n    y = n - x\n\n    print(sum_digit(x) + sum_digit(y))\n\nelse:\n\n    print(n)",
