    "code": " def prime(n):\n\n    if n == 1:\n\n        return 0\n\n    for j in range(2, int(pow(n, 0.5)) + 1):\n\n        if n % j == 0:\n\n            return 0\n\n    return 1\n\na, b = map(int, input().split())\n\nif prime(a) and prime(b):\n\n    for i in range(a + 1, b + 1):\n\n        if prime(i):\n\n            if i == b:\n\n                print(\"YES\")\n\n                break\n\n            else:\n\n                print(\"NO\")\n\n                break\n\nelse:\n\n    print(\"NO\")",
