    "code": " import math\n\nn, k = map(int, input().split())\n\narr = list(map(int, input().split()))\n\ni = 1\n\nj = (sum(arr) + k * i) / (len(arr) + i)\n\nif j - math.trunc(j) >= 0.5:\n\n    j = math.ceil(j)\n\nelse:\n\n    j = math.trunc(j)\n\nif j == k:\n\n    print(0)\n\nelse:\n\n    while True:\n\n        j = (sum(arr) + k * i) / (len(arr) + i)\n\n        if j - math.trunc(j) >= 0.5:\n\n            j = math.ceil(j)\n\n        else:\n\n            j = math.trunc(j)\n\n        if j == k:\n\n            print(i)\n\n            break\n\n        i += 1",
