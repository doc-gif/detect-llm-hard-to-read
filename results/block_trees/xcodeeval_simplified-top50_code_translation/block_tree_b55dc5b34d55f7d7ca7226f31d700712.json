    "code": " def main():\n\n    from math import sqrt\n\n    m, n, k = map(int, input().split())\n\n    if n < m:\n\n        n, m = m, n\n\n    low, high = 1, k + 1\n\n    while low + 1 < high:\n\n        mid = (low + high) // 2\n\n        t = mid - 1\n\n        v = min(int(sqrt(t)), m)\n\n        tn, tm = (t - 1) // m, t // n\n\n        vv = [t // i for i in range(tm + 1, v + 1)]\n\n        term1 = t // n * (n + m)\n\n        term2 = sum(vv) * 2\n\n        term3 = max(min((tn - tm), len(vv)) * m, 0)\n\n        term4 = v * v\n\n        term5 = sum(vv[: max(min(tn - tm, len(vv)), 0)])\n\n        if term1 + term2 + term3 - term4 - term5 < k:\n\n            low = mid\n\n        else:\n\n            high = mid\n\n    print(low)\n\nif __name__ == \"__main__\":\n\n    main()",
