    ],
    "code": " def main():\n\n    n, m, k, x, y = map(int, input().split())\n\n    if n == 1:\n\n        base = k // m\n\n        remainder = k % m\n\n        if remainder == 0:\n\n            print(base, base, base)\n\n        else:\n\n            sergei = base + (1 if y <= remainder else 0)\n\n            print(base + 1, base, sergei)\n\n        return\n\n    max_ans = -(10**20)\n\n    min_ans = 10**20\n\n    sergei_ans = 0\n\n    for i in range(1, n + 1):\n\n        inc1 = 2 * (n - i) * m\n\n        inc2 = 2 * (i - 1) * m\n\n        for j in range(1, m + 1):\n\n            lo, hi = -1, 10**18\n\n            while hi - lo > 1:\n\n                mid = (lo + hi) // 2\n\n                times2 = mid // 2 if inc2 != 0 else 0\n\n                times1 = mid - times2\n\n                if inc1 == 0:\n\n                    times1, times2 = 0, mid\n\n                total = (i - 1) * m + j + inc1 * times1 + inc2 * times2\n\n                if total <= k:\n\n                    lo = mid\n\n                else:\n\n                    hi = mid - 1\n\n            times2 = hi // 2 if inc2 != 0 else 0\n\n            times1 = hi - times2\n\n            if inc1 == 0:\n\n                times1, times2 = 0, hi\n\n            total = (i - 1) * m + j + inc1 * times1 + inc2 * times2\n\n            ans = hi + 1 if total <= k else hi\n\n            if i == x and j == y:\n\n                sergei_ans = ans\n\n            if ans > max_ans:\n\n                max_ans = ans\n\n            if ans < min_ans:\n\n                min_ans = ans\n\n    print(max_ans, min_ans, sergei_ans)\n\nmain()",
