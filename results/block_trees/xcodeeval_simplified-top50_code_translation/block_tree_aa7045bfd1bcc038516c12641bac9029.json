    "code": " n, m = map(int, input().split())\n\nif (m == 0 and n != 1) or m > 9 * n:\n\n    print(-1, -1)\n\nelif n == 1 and m == 0:\n\n    print(0, 0)\n\nelse:\n\n    min_num = 10 ** (n - 1)\n\n    for i in range(m - 1):\n\n        digit_position = i // 9\n\n        min_num += 10**digit_position\n\n    max_num = 0\n\n    for i in range(m):\n\n        digit_position = n - 1 - i // 9\n\n        max_num += 10**digit_position\n\n    print(min_num, max_num)",
