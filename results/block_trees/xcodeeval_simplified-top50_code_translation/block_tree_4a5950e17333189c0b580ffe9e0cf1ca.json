    "code": " def binsearch(predicate, left, right):\n\n    while left + 1 != right:\n\n        mid = (left + right) // 2\n\n        if predicate(mid):\n\n            right = mid\n\n        else:\n\n            left = mid\n\n    return right\n\nn = int(input())\n\nif n == 0:\n\n    print(0, 0)\n\nelse:\n\n    i = binsearch(lambda idx: n <= 3 * idx * (idx + 1), 0, 10**18)\n\n    acc = 3 * (i - 1) * i\n\n    j = binsearch(lambda idx: n <= acc + i * (idx + 1), -1, 6)\n\n    k = n - acc - i * j - 1\n\n    dy = [0, 2, 2, 0, -2, -2]\n\n    dx = [2, 1, -1, -2, -1, 1]\n\n    y = dy[(j + 1) % 6] + dy[j] * (i - 1) + dy[(j + 2) % 6] * k\n\n    x = dx[(j + 1) % 6] + dx[j] * (i - 1) + dx[(j + 2) % 6] * k\n\n    print(x, y)",
