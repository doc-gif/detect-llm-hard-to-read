    "code": " mod = 10**9 + 7\n\nf = [0] * 500000\n\ndef POW(a, b):\n\n    if b == 0:\n\n        return 1\n\n    if b & 1:\n\n        return POW(a, b // 2) ** 2 * a % mod\n\n    else:\n\n        return POW(a, b // 2) ** 2 % mod\n\ndef C(n, m):\n\n    if m > n:\n\n        return 0\n\n    return f[n] * POW(f[m], mod - 2) % mod * POW(f[n - m], mod - 2) % mod\n\nf[0] = 1\n\nfor i in range(1, 500000):\n\n    f[i] = f[i - 1] * i % mod\n\na, b, k, t = map(int, input().split())\n\nans = 0\n\nfor i in range(0, 2 * t + 1):\n\n    t1 = POW(-1, i) * C(2 * t, i) % mod\n\n    t2 = (\n\n        C(210000 + 2 * k * t - a + b + 2 * t - 1 - (2 * k + 1) * i + 1, 2 * t)\n\n        - C(1 + 2 * k * t - a + b + 2 * t - 1 - (2 * k + 1) * i, 2 * t)\n\n    ) % mod\n\n    ans = (ans + t1 * t2) % mod\n\nprint(ans)",
