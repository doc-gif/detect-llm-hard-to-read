    "code": " n, x, y = map(int, input().split())\n\na = list(map(int, input().split()))\n\nans_a = ans_b = 0\n\nans = True\n\nfor i in range(n // 2):\n\n    left, right = a[i], a[n - i - 1]\n\n    if left != right:\n\n        if left == 2 or right == 2:\n\n            if left == 0 or right == 0:\n\n                ans_a += 1\n\n            elif left == 1 or right == 1:\n\n                ans_b += 1\n\n        else:\n\n            ans = False\n\n            break\n\n    else:\n\n        if left == 2 and right == 2:\n\n            if x < y:\n\n                ans_a += 2\n\n            else:\n\n                ans_b += 2\n\nif ans:\n\n    middle_cost = 0\n\n    if n % 2 == 1 and a[n // 2] == 2:\n\n        middle_cost = min(x, y)\n\n    print(ans_a * x + ans_b * y + middle_cost)\n\nelse:\n\n    print(-1)",
