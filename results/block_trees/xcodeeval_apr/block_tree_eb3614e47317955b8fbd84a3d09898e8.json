    "code": " def soe(n):\n\n    primes=[True]*(n+1)\n\n    primes[0]=primes[1]=False\n\n    i=4 \n\n    while i<n:\n\n        primes[i]=False\n\n        i+=2 \n\n    i=3 \n\n    while i*i<=n:\n\n        for j in range(i*i,n,2*i):\n\n            primes[j]=False\n\n        i+=2 \n\n    ans=[]\n\n    for i in range(len(primes)):\n\n        if primes[i]:\n\n            ans.append(i)\n\n    return ans\n\nprim=soe(10**8)\n\nn=int(input())\n\nct=0 \n\nf=-1\n\nfor i in prim:\n\n    if n%i==0:\n\n        ct+=1 \n\n        f=i\n\nif ct>=2:\n\n    print(1)\n\nelif ct==1:\n\n    print(f)\n\nelse:\n\n    print(n)",
