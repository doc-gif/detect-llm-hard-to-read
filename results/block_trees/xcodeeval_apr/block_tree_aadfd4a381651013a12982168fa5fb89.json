    "code": " n, k = map(int, input().split())\n\ns = list(input())\n\nans = False\n\nfor i in range(len(s) - k):\n\n    flag = True\n\n    for j in range(i, i + k):\n\n        if (s[j] == 'Y'):\n\n            flag = False\n\n            break\n\n    if ((i + k) < len(s)) and s[i + k] == 'N': flag = False\n\n    if (i > 0) and (s[i - 1] == 'N'): flag = False\n\n   # print(i, flag)\n\n    if (flag):\n\n        ans = True\n\n        break\n\nmaximum = 0\n\ni = 0\n\nwhile (i < len(s)):\n\n    now = 0\n\n    while (s[i] != 'N'):\n\n        i += 1\n\n        if (i >= len(s)):\n\n            break\n\n    if (i >= len(s)): break\n\n    while (i < len(s)) and (s[i] == 'N'):\n\n        i += 1\n\n        now += 1\n\n    maximum = max(maximum, now)\n\nif ans and (maximum <= k):\n\n    print('YES')\n\nelse: print('NO')\n",
