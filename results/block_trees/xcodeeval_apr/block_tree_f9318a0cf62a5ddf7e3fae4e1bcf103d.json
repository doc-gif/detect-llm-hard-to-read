    "code": " from math import sqrt, ceil\n\nfrom collections import namedtuple\n\n\n\ndef add(a, b):\n\n    return a[0] + b[0], a[1] + b[1]\n\n\n\ndef count(p):\n\n    return p * (3 * p + 2)\n\n\n\n\n\ndef bin_search(n):\n\n    l = 0\n\n    r = ceil(sqrt(n))\n\n    while r - l > 1:\n\n        m = (l + r) // 2\n\n        if count(m) > n:\n\n            r = m - 1\n\n        else:\n\n            l = m\n\n    if count(r) > n:\n\n        return l\n\n    else:\n\n        return r\n\n\n\n\n\ndef get_pos(n, p):\n\n    if n < p: # /\n\n        return add( (p - 1, -2 * p + 2), (n, 2 * n) ) \n\n    n -= p\n\n    if n < p - 1: # \\\n\n        return add( (1 + 2 * (p - 1), 2), (-n, 2 * n) )\n\n    n -= p - 1\n\n    if n < p: # -\n\n        return add( (p, 2 * p), (-2 * n, 0) )\n\n    n -= p\n\n    if n < p: # /\n\n        return add( (-p, 2 * p), (-n, -2 * n) )\n\n    n -= p\n\n    if n < p: # -\n\n        return add( (-2 * p, 0), (n, -2 * n) )\n\n    raise RuntimeError(\"You're a big guy\")\n\n\n\n\n\nn = int(input())\n\nif n == 0:\n\n    print(0, 0)\n\nelse:\n\n    p = bin_search(n)\n\n    start = count(p)\n\n    n -= start\n\n    ans = get_pos(n, p + 1)\n\n    print(ans[0], ans[1])\n",
