    "code": " #http://codeforces.com/problemset/problem/868/A\n\n\n\nfrom itertools import permutations\n\n\n\ndef unlock(word,substring):\n\n    if len(word) == 1:\n\n        word = word + word\n\n    perms = [\"\".join(w) for w in permutations(word)]\n\n    for perm in perms:\n\n        end = len(substring)-1\n\n        start = 0\n\n        check = perm[:end+1]\n\n        #print(check)\n\n        while end != len(perm):\n\n            if check == substring:\n\n                return True\n\n            end += 1\n\n            start += 1\n\n            check = perm[start:end+1]\n\n            #print(check)\n\n    return False\n\n        \n\n    print(perms)\n\n\n\n\n\n#print(unlock([\"ah\",\"oy\",\"to\",\"ha\"],\"ya\"))\n\n#print(unlock([\"ht\",\"tp\"],\"hp\"))\n\n#print(unlock([\"ah\"],\"ha\"))\n\n\n\n\n\nwhile True:\n\n    try:\n\n        pw = input()\n\n        count = input()\n\n        words = []\n\n        for i in range(int(count)):\n\n            words.append(input())\n\n        if unlock(words,pw):\n\n            print(\"YES\")\n\n        else:\n\n            print(\"NO\")\n\n    except EOFError:\n\n        break\n",
