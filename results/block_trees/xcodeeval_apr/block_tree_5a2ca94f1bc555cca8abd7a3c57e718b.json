    "code": " from math import factorial\n\ndef solve(n,p,a):\n\n    if p is 9:\n\n        if n>=a[9]:\n\n            return 1\n\n        else:\n\n            return 0\n\n    elif p is 0:\n\n        ans=0\n\n        for i in range(a[0],n):\n\n            z=solve(n-i,1,a)\n\n            z*=factorial(n-1)\n\n            z//=factorial(i)\n\n            z//=factorial(n-1-i)\n\n            ans+=z\n\n        return ans\n\n    else:\n\n        ans=0\n\n        for i in range(a[p],n+1):\n\n            z=solve(n-i,p+1,a)\n\n            z*=factorial(n)\n\n            z//=factorial(i)\n\n            z//=factorial(n-i)\n\n            ans+=z\n\n        return ans\n\nhell=1000000007\n\nn=int(input())\n\na=input().rstrip().split(' ');\n\nfor i in range(0,len(a)):\n\n    a[i]=int(a[i])\n\nans=0\n\nfor i in range(1,n+1):\n\n    ans+=solve(i,0,a)\n\n    ans%=hell\n\nprint(ans)",
