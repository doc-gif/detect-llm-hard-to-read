    "code": " from collections import defaultdict as dd\n\nfrom collections import deque\n\nimport bisect\n\nimport heapq\n\n\n\ndef ri():\n\n    return int(input())\n\n\n\ndef rl():\n\n    return list(map(int, input().split()))\n\n\n\ndef egcd(a, b):\n\n    if a == 0:\n\n        return (b, 0, 1)\n\n    else:\n\n        g, y, x = egcd(b % a, a)\n\n        return (g, x - (b // a) * y, y)\n\n\n\ndef modinv(a, m):\n\n    g, x, y = egcd(a, m)\n\n    if g != 1:\n\n        raise Exception('modular inverse does not exist')\n\n    else:\n\n        return x % m\n\n\n\nmod = 998244353\n\ndef solve():\n\n    n, k = rl()\n\n    if k > n:\n\n        print (0)\n\n        return\n\n    elif k == 1:\n\n        print (n)\n\n        return\n\n\n\n    f = [1]\n\n    fi = [1]\n\n    for i in range(1, n + 1):\n\n        f.append((f[-1]*i)%mod)\n\n        fi.append((fi[-1] * modinv(i, mod))%mod)\n\n\n\n    def C(a,b):\n\n        return f[a]*fi[b]*fi[a-b]\n\n\n\n    d = n\n\n    i = 1\n\n    answer = 0\n\n    while d >= k:\n\n        answer = (answer + C(d - 1, k - 1)) % mod\n\n        i += 1\n\n        d = n // i\n\n    print (answer)\n\n\n\n\n\nmode = 'T'\n\n\n\nif mode == 'T':\n\n    t = ri()\n\n    for i in range(t):\n\n        solve()\n\nelse:\n\n    solve()\n",
