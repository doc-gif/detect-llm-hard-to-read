    "code": " import math\n\nimport random\n\nimport sys\n\n\n\ndef main(s):\n\n    \n\n    if (len(s)==1 and (s[0]==\"0\" or s[0]==\"_\" or s[0]==\"X\")):\n\n        return 1\n\n    elif (s[0]==\"0\" and len(s)>1):\n\n        return 0\n\n    elif (len(s)==1):\n\n        return 0\n\n    mult1=1\n\n    mult2=1\n\n    f=False\n\n    for i in range(len(s)-2): \n\n\n\n        if s[i]==\"_\":\n\n            if (i!=0):\n\n                mult1*=10\n\n            else:\n\n                mult1*=9\n\n        elif s[i]==\"X\":\n\n            if (i!=0):\n\n                mult2=10 \n\n            else:\n\n                mult2=9 \n\n                f=True\n\n    ans=0\n\n    for i in range(100):\n\n        if (i%25)!=0:\n\n            continue\n\n        val=list([c for c in str(i)]) \n\n        if (i==0):\n\n            val=[\"0\",\"0\"]\n\n        \n\n        mult_val=mult2\n\n        check=[s[-2],s[-1]]\n\n\n\n        if check[0]==\"X\":\n\n            if (val[0]=='0' and f):\n\n                continue\n\n            check[0]=val[0] \n\n            mult_val=1\n\n            if check[1]==\"X\":\n\n                \n\n                check[1]=val[0] \n\n                \n\n        if (check[1]==\"X\" and check[0] !=\"X\"):\n\n            if (val[1]=='0' and f):\n\n                continue\n\n            check[1]=val[1] \n\n            mult_val=1\n\n        if (check[0]==\"_\"):\n\n            check[0]=val[0]\n\n        if (check[1]==\"_\"):\n\n            check[1]=val[1] \n\n        if (val==check) and not (len(s)==2 and check[0]==\"0\"):\n\n            ans+=mult_val*mult1\n\n\n\n    return ans\n\n    \n\n\n\n            \n\ns=input() \n\nprint(main(s))\n\n\n\n\n\n\n\n                    \n\n                    \n\n\n\n            \n\n            \n",
