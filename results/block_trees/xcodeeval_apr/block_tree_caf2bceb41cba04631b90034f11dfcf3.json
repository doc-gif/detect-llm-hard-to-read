    "code": " import sys\n\ninput = sys.stdin.readline\n\n\n\nn,m=map(int,input().split())\n\n\n\nS=[i for i in range(n+1)]\n\n\n\nfor i in range(2,n+1):\n\n    if S[i]==i:\n\n        for j in range(i,n+1,i):\n\n            if S[j]==j:\n\n                S[j]=i\n\n\n\ndef fact(x):\n\n    P=[]\n\n    while x!=1:\n\n        P.append(S[x])\n\n        x//=S[x]\n\n\n\n    NOW={1}\n\n    for p in P:\n\n        NOW|={n*p for n in NOW}\n\n\n\n    return NOW\n\n\n\nDP=[0]*(n+1)\n\n\n\nDP[1]=1\n\nDP[2]=2\n\nDP[3]=5\n\n#DP[4]=12\n\n#DP[5]=25\n\n\n\nfor i in range(4,n+1):\n\n    SU=DP[i-1]*2+1\n\n    \n\n    for f in fact(i):\n\n        if f==1 or f==i:\n\n            continue\n\n        SU+=DP[i//f]-DP[(i-1)//f]\n\n\n\n    DP[i]=SU%m\n\n\n\nprint(DP[n])\n\n    \n\n    \n",
