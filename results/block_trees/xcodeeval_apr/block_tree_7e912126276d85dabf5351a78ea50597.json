    "code": " import sys\n\nrange = xrange\n\ninput = raw_input\n\n\n\nMOD = 10**9+7\n\ndef mult(A,B):\n\n    n = len(A)\n\n    C = [[0]*n for _ in range(n)]\n\n    for x in range(n):\n\n        for y in range(n):\n\n            for z in range(n):\n\n                C[x][y] += A[z][y]*B[x][z]\n\n            C[x][y]%=MOD\n\n    return C\n\n\n\ndef vecmult(A,B):\n\n    n = len(A)\n\n    C = [0]*n\n\n    for y in range(n):\n\n        C[y] = sum(A[x][y]*B[x] for x in range(n))%MOD\n\n    return C\n\n\n\nn,m = [int(x) for x in input().split()]\n\n\n\n\n\n#def DP(n):\n\n#    if n<=0:\n\n#        return 1 if n==0 else 0\n\n#    else:\n\n#        return DP(n-m) + DP(n-1)\n\n\n\n\n\nmapper = [[0]*m for _ in range(m)]\n\n\n\nmapper[0][0] = 1\n\nmapper[-1][0] = 1\n\nfor i in range(m-1):\n\n    mapper[i][i+1] = 1\n\n\n\ndef power(A,B,m):\n\n    n = len(A)\n\n    if m == 0:\n\n        return B\n\n    while m>1:\n\n        if m%2==1:\n\n            B = vecmult(A,B)\n\n        A = mult(A,A)\n\n        m//=2\n\n    return vecmult(A,B)\n\n\n\nvec = [1]*m\n\nvec = power(mapper,vec,n)\n\nprint(vec[-1]%MOD)\n",
