    "code": " import sys\n\n\n\nlines = []\n\nfor line in sys.stdin:\n\n    lines.append(line)\n\n\n\nn = int(lines[0].rstrip(\"\\r\\n\\t \"))\n\n\n\nmax_price = n * 2 - 1\n\nnines = 0\n\nmp = max_price\n\nwhile mp >= 9:\n\n    nines += 1\n\n    mp = int(mp / 10)\n\nif nines < 1:\n\n    print(\"0\")\n\n    exit()\n\nprice_suffix = \"9\"*nines\n\n\n\npairs = set()\n\ndef add_pairs(max_x: int, price: int):\n\n    from_max = int(price / 2)\n\n    to_min = from_max + 1\n\n    to_max = price - 1\n\n    if to_max > max_x:\n\n        to_max = max_x\n\n    from_min = price - to_max\n\n    for x in range(from_min, from_max + 1):\n\n        pairs.add(str(x) + ':' + str(price - x))\n\n\n\n\n\ncnt = 0\n\nfor d in range(0, 10):\n\n    if d > 0:\n\n        price = int(str(d) + price_suffix)\n\n    else:\n\n        price = int(price_suffix)\n\n    if price <= max_price:\n\n        add_pairs(n, price)\n\n\n\nprint(len(pairs))\n",
