    "code": " from math import sqrt\n\n\n\ndef tax(n):\n\n    if n == 4:\n\n        return 2\n\n    if n < 4:\n\n        return 1\n\n    prime_lst = [i for i in range(2, n+1)]\n\n    pointer = 0\n\n    while pointer != n-1:\n\n        if prime_lst[pointer] == 0:\n\n            pass\n\n        else:\n\n            multiple = prime_lst[pointer]\n\n            temp = pointer\n\n            while pointer <= n:\n\n                pointer += multiple\n\n                try:\n\n                    prime_lst[pointer] = 0\n\n                except IndexError:\n\n                    pass\n\n            pointer = temp\n\n        pointer += 1\n\n    primes = []\n\n    for i in prime_lst:\n\n        if i != 0:\n\n            primes.append(i)\n\n    count = 0\n\n    lp = 0\n\n    while n > 0:\n\n        try:\n\n            if n - primes[-1-lp] >= 0 and n-primes[-1-lp] != 1:\n\n                n -= primes[-1-lp]\n\n                count += 1\n\n            else:\n\n                lp += 1\n\n        except IndexError:\n\n            lp = 0\n\n    return count\n\n\n\n\n\nn = int(input())\n\nprint(tax(n))\n\n\n\n\n\n\n",
