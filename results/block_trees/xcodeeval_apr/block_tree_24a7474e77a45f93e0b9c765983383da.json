    "code": " n, m = map(int, input().split())\n\ngrid = [None for _ in range(n)]\n\nfor i in range(n):\n\n<0x09>grid[i] = list(input())\n\npos = []\n\nfor i in range(n):\n\n<0x09>for j in range(m):\n\n<0x09><0x09>if grid[i][j] == 'W':\n\n<0x09><0x09><0x09>pos.append((i, j))\n\nln = len(pos)\n\n\n\nmemo = {}\n\ndef solve(x, magic):\n\n<0x09>if (x, magic) not in memo:\n\n<0x09><0x09>if x >= ln:\n\n<0x09><0x09><0x09>return 0\n\n\n\n<0x09><0x09>res = solve(x + 1, magic)\n\n<0x09><0x09>i, j = pos[x]\n\n\n\n<0x09><0x09>if j > 0 and grid[i][j - 1] == 'P':\n\n<0x09><0x09><0x09>grid[i][j - 1] = '.'\n\n<0x09><0x09><0x09>res = max(res, 1 + solve(x + 1, magic + i * n + (j - 1) * m))\n\n<0x09><0x09><0x09>grid[i][j - 1] = 'P'\n\n\n\n<0x09><0x09>if i > 0 and grid[i - 1][j] == 'P':\n\n<0x09><0x09><0x09>grid[i - 1][j] = '.'\n\n<0x09><0x09><0x09>res = max(res, 1 + solve(x + 1, magic + (i - 1) * n + j * m))\n\n<0x09><0x09><0x09>grid[i - 1][j] = 'P'\n\n\n\n<0x09><0x09>if i < n - 1 and grid[i + 1][j] == 'P':\n\n<0x09><0x09><0x09>grid[i + 1][j] = '.'\n\n<0x09><0x09><0x09>res = max(res, 1 + solve(x + 1, magic + (i + 1) * n + j * m))\n\n<0x09><0x09><0x09>grid[i + 1][j] = 'P'\n\n\n\n<0x09><0x09>if j < m - 1 and grid[i][j + 1] == 'P':\n\n<0x09><0x09><0x09>grid[i][j + 1] = '.'\n\n<0x09><0x09><0x09>res = max(res, 1 + solve(x + 1, magic + (i + 1) * n + j * m))\n\n<0x09><0x09><0x09>grid[i][j + 1] = 'P'\n\n\n\n<0x09><0x09>memo[x] = res\n\n<0x09><0x09>return res\n\n<0x09>else:\n\n<0x09><0x09>return memo[x]\n\n\n\nprint(solve(0, 0))\n",
