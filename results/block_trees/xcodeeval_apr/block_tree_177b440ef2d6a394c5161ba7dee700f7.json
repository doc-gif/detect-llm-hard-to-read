    "code": " n = int(input())\n\nsz = len(str(n))\n\ndef get(x):\n\n    ans = 0\n\n    nw = 1\n\n    x1 = x\n\n    for i in range(sz):\n\n        x = x1\n\n        if x < nw:\n\n            while x < nw: x *= 10\n\n            x -= 1 #тк сука [1;x)\n\n        else:\n\n            while x >= nw * 10: x //= 10\n\n        x = min(x, n)\n\n        ans += x - nw + 1\n\n        nw *= 10\n\n    return ans\n\n\n\n\n\nMOD = 998244353\n\n\n\nans = 0\n\ni = 1\n\nwhile i <= n:\n\n    l = i\n\n    r = min(n, 10 ** (len(str(i))) - 1) + 1\n\n    nw = (get(i) - i) // MOD\n\n    while r - l > 1:\n\n        mid = (l + r) // 2\n\n        x = (get(mid) - mid) // MOD\n\n        if nw == x:\n\n            l = mid\n\n        else:\n\n            r = mid\n\n    ans += nw * (r - i)\n\n    # i += 1\n\n    i = r\n\nprint(ans * -MOD)\n",
