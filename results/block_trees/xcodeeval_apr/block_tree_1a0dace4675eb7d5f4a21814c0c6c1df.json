    "code": " MOD = int(1e9+7)\n\n\n\ndef mult(l, r):\n\n<0x09>return (l*r)%MOD\n\n\n\ndef fast_exp(b, e):\n\n<0x09>if e == 0:\n\n<0x09><0x09>return 1\n\n<0x09>if e%2 == 1:\n\n<0x09><0x09>return mult(b, fast_exp(b, e-1))\n\n<0x09>else:\n\n<0x09><0x09>b2 = fast_exp(b, e//2)\n\n<0x09><0x09>return mult(b2, b2)\n\n\n\n[n, k] = [int(s) for s in input().split(\" \")]\n\nprint(n, k)\n\nfact = (n+1)*[1]\n\nfor i in range(1, n+1):\n\n<0x09>fact[i] = mult(i, fact[i-1])\n\n\n\n\n\nifact = (n+1)*[1]\n\nifact[n] = fast_exp(fact[n], MOD-2)\n\nfor i in reversed(range(1, n)):\n\n<0x09>ifact[i] = mult(i+1, ifact[i+1])\n\n\n\ndef binom(N, K):\n\n<0x09>return mult(mult(fact[N], ifact[K]), ifact[N-K])\n\n\n\ndef get(i, j):\n\n<0x09>X = i*j\n\n<0x09>Y = (n-i)*j\n\n<0x09>Z = (n-j)*i\n\n<0x09>tot = X+Y+Z\n\n<0x09>ans = 0\n\n<0x09>if (i+j)%2 == 0:\n\n<0x09><0x09>ans = 1\n\n<0x09>else:\n\n<0x09><0x09>ans = (MOD - 1)\n\n<0x09>ans = mult(ans, binom(n, j))\n\n<0x09>ans = mult(ans, binom(n, i))\n\n<0x09>ans = mult(ans, fast_exp(k, n*n - tot))\n\n<0x09>ans = mult(ans, fast_exp(k-1, tot))\n\n<0x09>return ans\n\n\n\nans = 0\n\nfor i in range(0, n+1):\n\n<0x09>for j in range(0, n+1):\n\n<0x09><0x09>ans = (ans + get(i, j)) % MOD\n\n\n\nprint(ans)\n",
