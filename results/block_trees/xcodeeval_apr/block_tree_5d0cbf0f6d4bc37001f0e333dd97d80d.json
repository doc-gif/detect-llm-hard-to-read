    "code": " from collections import defaultdict\n\n#n = int(raw_input())\n\nn,b = [int(x) for x in raw_input().split()]\n\n#arr = [int(x) for x in raw_input().split()]\n\n\n\ns = 0\n\nd_osn = defaultdict(int)\n\nwhile b > 1:\n\n    for i in range(2,b):\n\n        if b % i == 0:\n\n            d_osn[i] += 1\n\n            b /= i\n\n            break\n\n    else:\n\n        d_osn[b] += 1\n\n        b = 1\n\n#print(d_osn)\n\nizv = defaultdict(int)\n\nfor i in range(1,n+1):\n\n    for el in d_osn:\n\n        while i % el == 0:\n\n            i = i / el\n\n            izv[el] += 1\n\nres = -1\n\n#print(izv)\n\nfor k in d_osn:\n\n    mlt = 0 if k not in izv else izv[k] // d_osn[k]\n\n    if res == -1:\n\n        res = mlt\n\n    elif mlt < res:\n\n        res = mlt\n\nprint(res)",
