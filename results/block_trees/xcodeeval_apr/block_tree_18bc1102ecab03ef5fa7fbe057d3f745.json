    "code": " import string\n\n\n\ndef Correct(word):\n\n    up = 0\n\n    lo = 0\n\n    flo = 0\n\n    new = ''\n\n    alpha = list(string.ascii_lowercase)\n\n    ALPHA = list(string.ascii_uppercase)\n\n    dic_one = {}\n\n    dic_two = {}\n\n    for i in range(0,26):\n\n        dic_one[ALPHA[i]] = alpha[i]\n\n    for j in range(0,26):\n\n        dic_two[alpha[j]] = ALPHA[j] \n\n    l = list(word)\n\n    for m in range(len(word)):\n\n        for k in range(0,26):\n\n            if l[m] == ALPHA[k]:\n\n                up = up + 1\n\n            elif l[0] == alpha[k]:\n\n                flo = 1\n\n    if l[0] == l[1]:\n\n        if up == len(word):\n\n            for m in range(0,len(word)):\n\n                l[m] = dic_one[l[m]]\n\n    elif up == len(word) and l[0] != l[1]:\n\n        for m in range(1,len(word)):\n\n            l[m] = dic_one[l[m]]\n\n    elif flo == 1 and up == len(word)-1:\n\n        l[0] = dic_two[l[0]]\n\n        for m in range(1,len(word)):\n\n            l[m] = dic_one[l[m]]\n\n    else:\n\n        return word\n\n    for n in range(len(word)):\n\n        new = new + l[n]\n\n    return new\n\n\n\nword = str(input())\n\nprint(Correct(word))",
