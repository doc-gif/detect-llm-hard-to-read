    "code": " import sys\n\ninput = sys.stdin.buffer.readline\n\nsys.setrecursionlimit(10**7)\n\n\n\nn, m = [int(item) for item in input().split()]\n\nif n > m:\n\n    n, m = m, n\n\nif n == 1 and m == 1:\n\n    print(2)\n\n    exit()\n\ndp = [[0] * m for _ in range(4)]\n\n\n\ndp[0][1] = 1\n\ndp[1][1] = 1\n\ndp[2][1] = 1\n\ndp[3][1] = 1\n\n\n\nfor i in range(2, m):\n\n    dp[0][i] += dp[2][i-1] \n\n    dp[1][i] += dp[0][i-1] \n\n    dp[1][i] += dp[2][i-1] \n\n    dp[2][i] += dp[1][i-1] \n\n    dp[2][i] += dp[3][i-1] \n\n    dp[3][i] += dp[1][i-1] \n\n\n\n# for line in dp:\n\n#     print(line)\n\nlr = 0\n\nud = 0\n\n\n\nfor i in range(4):\n\n    lr += dp[i][m-1]\n\n    ud += dp[i][n-1]\n\n\n\nif n == 1:\n\n    print(lr)\n\n    exit()\n\nelse:\n\n    print(lr + ud - 2)",
    "block_tree": {
      "block_code": " import sys\ninput = sys.stdin.buffer.readline\nsys.setrecursionlimit(10**7)\nn, m = [int(item) for item in input().split()]\nif n > m:\n    n, m = m, n\nif n == 1 and m == 1:\n    print(2)\n    exit()\ndp = [[0] * m for _ in range(4)]\ndp[0][1] = 1\ndp[1][1] = 1\ndp[2][1] = 1\ndp[3][1] = 1\nfor i in range(2, m):\n    dp[0][i] += dp[2][i-1] \n    dp[1][i] += dp[0][i-1] \n    dp[1][i] += dp[2][i-1] \n    dp[2][i] += dp[1][i-1] \n    dp[2][i] += dp[3][i-1] \n    dp[3][i] += dp[1][i-1] \n# for line in dp:\n#     print(line)\nlr = 0\nud = 0\nfor i in range(4):\n    lr += dp[i][m-1]\n    ud += dp[i][n-1]\nif n == 1:\n    print(lr)\n    exit()\nelse:\n    print(lr + ud - 2)",
