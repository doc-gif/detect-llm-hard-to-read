    "code": " m, s = map(int, input().split())\n\n\n\nans = []\n\nflag = 0\n\ntemp = 0\n\nif s!=0:\n\n    while s >= 0 and s//9<m or (s//9==m and s%9==0) and temp<m:\n\n        flag = 1\n\n        temp += 1\n\n        if s-9 > 0:\n\n            ans.append(9)\n\n            s -= 9\n\n        else:\n\n            ans.append(s)\n\n            s = 0\n\n            continue\n\n\n\n        if s==0 and temp<m:\n\n            ans.append(0)\n\n\n\nif flag:\n\n    ans1 = \"\".join(map(str,ans))\n\n    if ans[-1]==0:\n\n        for i in range(len(ans)):\n\n            if ans[-1-i]!=0:\n\n                ans[-1-i] -= 1\n\n                break\n\n        ans[-1] = 1\n\n\n\n    ans2 = \"\".join(map(str,ans[::-1]))\n\n    print(ans2, ans1)\n\nelif flag==0 and s==0 and m==1:\n\n    print(0,0)\n\nelse:\n\n    print(-1, -1)",
