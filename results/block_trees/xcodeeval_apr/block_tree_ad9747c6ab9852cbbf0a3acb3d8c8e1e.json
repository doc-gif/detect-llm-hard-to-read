    "code": " def inc(arr):\n\n    for i in range(len(arr) - 1, -1, -1):\n\n        w = arr[i]\n\n        if w == 0:\n\n            for j in range(len(arr) - 1, i, -1):\n\n                arr[j] = 0\n\n            arr[i] = 1\n\n            return arr\n\n\n\n\n\ndef proveralo1(a, arr):\n\n    c = []\n\n    for i in range(len(arr)):\n\n        if arr[i] == 1:\n\n            c.append(a[i])\n\n    return c\n\ndef proveralo2(c):\n\n    f = 0\n\n    for i in range(len(c)):\n\n        if f == 1 and c[i] == 0:\n\n            return False\n\n        if f == 0 and c[i] == 1:\n\n            f = 1\n\n    return True\n\n\n\n\n\nn = int(input())\n\narr = [0] * n\n\na = list(map(int,input().split()))\n\ns = 0\n\nc1 = []\n\nwhile True:\n\n    c = []\n\n    r = 0\n\n    arr = inc(arr)\n\n    c = proveralo1(a,arr)\n\n    if proveralo2(c) == True:\n\n        r = len(c)\n\n    if r > s:\n\n        s = r\n\n        c1 = c\n\n    if inc(arr) == None:\n\n        break\n\nprint(s)",
