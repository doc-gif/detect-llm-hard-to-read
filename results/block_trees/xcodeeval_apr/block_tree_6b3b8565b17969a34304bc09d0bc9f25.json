    "code": " def divi(n):\n\n    if n == 0:\n\n        return 0\n\n    elif n == 1:\n\n        return n\n\n    elif n == 11:\n\n        return 2\n\n    elif n % 11 <= 6:\n\n        k = n % 11\n\n        j = 0\n\n        cont_um = 0\n\n        while j < n:\n\n            j += 1\n\n            cont_um += 1\n\n        return cont_um\n\n    else:\n\n        k = n % 11\n\n        h = 11\n\n        contador_de_um = 2\n\n        while h > n:\n\n            h -= 1\n\n            contador_de_um += 1\n\n        return contador_de_um\n\n\n\n\n\ndef divide_maior(n):\n\n    divisao = n // 11\n\n    resto = n % 11\n\n    valor_menor_que_onze = divi(resto)\n\n    valor_maior_que_onze = divisao * 2\n\n    return valor_maior_que_onze + valor_menor_que_onze\n\n\n\n\n\ndef execute():\n\n    n = int(input())\n\n    m = divide_maior(n)\n\n    print(m)\n\n\n\n\n\nexecute()\n",
