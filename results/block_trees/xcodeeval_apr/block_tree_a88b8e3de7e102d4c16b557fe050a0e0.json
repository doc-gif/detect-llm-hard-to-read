    "code": " n,m,k,x,y=list(map(int,input().split()))\n\nif n>2:\n\n    if n*m<k:\n\n        b=(k-n*m)//((n-1)*m)\n\n        k=k-n*m-b*(n-1)*m\n\n        m2=b+1\n\n        m1=(m2+1)//2\n\n        if x==1 or x==n:\n\n            m3=m1\n\n        else:\n\n            m3=m2\n\n        if b%2==0:\n\n            i=n-1\n\n            c=-1\n\n        else:\n\n            if x==1:\n\n                m3=m3+1\n\n            i=2\n\n            c=1\n\n        j=1\n\n        if k>0:\n\n            m2=m2+1\n\n        while k>0:\n\n            if x==i and y==j:\n\n                m3=m3+1\n\n            k=k-1\n\n            j=j+1\n\n            if j==m+1:\n\n                j=1\n\n                i=i+c\n\n        print(m2,m1,m3)\n\n    elif k==n*m:\n\n        print(1,1,1)\n\n    else:\n\n        if x<=k//m:\n\n            print(1,0,1)\n\n        elif x==k//m+1 and y<=k%m:\n\n            print(1,0,1)\n\n        else:\n\n            print(1,0,0)\n\nelif n==2:\n\n    m2=k//(n*m)\n\n    m3=m2\n\n    m1=m2\n\n    k=k%(n*m)\n\n    if k>0:\n\n        m2=m2+1\n\n    i=1\n\n    j=1\n\n    while k>0:\n\n        if x==i and y==j:\n\n            m3=m3+1\n\n        j=j+1\n\n        if j==m+1:\n\n            j=1\n\n            i=i+1\n\n    print(m2,m1,m3)\n\nelse:\n\n    if k%m==0:\n\n        print(k//m,k//m,k//m)\n\n    else:\n\n        if y<=k%m:\n\n            print(k//m+1,k//m,k//m+1)\n\n        else:\n\n            print(k//m+1,k//m,k//m)",
