    "code": " # N boxes can be filled with type H or type T objects\n\n# 1 H object takes 1 box\n\n# 1 H can turn into M T objects which must take contiguous boxes\n\n# How many ways to fill N boxes?\n\n\n\n# E.g. N=4, M=2 -> return 5: HHHH, HHTT, HTTH, TTHH, TTTT\n\n\n\n# Constraints: N <= 10^18\n\n\n\n\n\ndef _solve(n, m, memo):\n\n<0x09>if n <= 0: return 0\n\n<0x09>if n < m: return 1\n\n<0x09>if n == 1: return 2\n\n<0x09>if (n, m) in memo: return memo[(n, m)]\n\n\n\n<0x09>out = 0\n\n<0x09>mid = n // 2\n\n\n\n<0x09># No M block hanging over 2 halves\n\n<0x09>out += _solve(mid, m, memo) * _solve(n-mid, m, memo) % 1000000007 \n\n\n\n<0x09># M block over 2 halves\n\n<0x09>for i in range(1,m):  # i = part of M block in first half\n\n<0x09><0x09>if mid-i < 0 or n-mid+i-m < 0: continue\n\n<0x09><0x09>n1 = 1 if mid-i == 0 else _solve(mid-i, m, memo)\n\n<0x09><0x09>n2 = 1 if n-mid+i-m == 0 else _solve(n-mid+i-m, m, memo)\n\n<0x09><0x09>out += n1*n2 \n\n\n\n<0x09>memo[(n, m)] = out\n\n<0x09>return out\n\n\n\n\n\ndef solve(n, m):\n\n<0x09>return _solve(n, m, {})\n\n\n\n\n\ndef main():\n\n<0x09>from sys import stdin\n\n\n\n<0x09>n, m = list(map(int, stdin.readline().strip().split()))\n\n<0x09>out = solve(n, m)\n\n<0x09>print('{}'.format(out))\n\n\n\n\n\nif __name__ == '__main__':\n\n<0x09>main()\n",
