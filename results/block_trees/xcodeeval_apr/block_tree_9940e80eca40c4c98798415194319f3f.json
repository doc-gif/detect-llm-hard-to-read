    "code": " def div(num):\n\n    div=[]\n\n    for i in range (1,num+1):\n\n        if num%i==0:\n\n            div.append(i)\n\n    return div\n\ndef cdiv(n1,n2):\n\n    cd=[]\n\n    for i in range(max(n1,n2)):\n\n        if i in div(n1) and i in div(n2) and i not in cd:\n\n            cd.append(i)\n\n    return cd\n\nwh,lh,lw=map(int,input().split())\n\nph=cdiv(wh,lh)\n\npw=cdiv(wh,lw)\n\npl=cdiv(lh,lw)\n\nl , w ,h =1,1,1\n\nwhile 1:\n\n    if wh==w*h and lh==l*h and lw==l*w:\n\n        break\n\n    for i in ph:\n\n        for j in pw:\n\n            for k in pl:\n\n                if wh==i*j and lh==k*i and lw==k*j:\n\n                    h=i\n\n                    w=j\n\n                    l=k\n\n                    break\n\n            if wh==w*h and lh==l*h and lw==l*w:\n\n                break\n\n        if wh==w*h and lh==l*h and lw==l*w:\n\n                break\n\n    \n\nprint((l+h+w)*4)\n",
