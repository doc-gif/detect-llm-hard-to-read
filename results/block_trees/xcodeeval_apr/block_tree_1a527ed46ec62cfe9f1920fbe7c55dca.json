    "code": " def plane(a, b, c):\n\n    if a == b == 0 != c:\n\n        return 0\n\n    else:\n\n        return -1\n\n\n\ndef hline(b1, c1, a2, b2, c2):\n\n    if b1 == 0:\n\n        if c1 == 0:\n\n            return plane(a2, b2, c2)\n\n        else:\n\n            return -1\n\n    elif a2 == 0:\n\n        if b2 == 0 != c2:\n\n            return 0\n\n        elif c2 * b1 == c1 * b2:\n\n            return -1\n\n        else:\n\n            return 0\n\n    else:\n\n        return 1\n\n\n\ndef vline(a1, c1, a2, b2, c2):\n\n    return hline(a1, c1, b2, a2, c2)\n\n\n\n\n\ndef intersect(a1, b1, c1, a2, b2, c2):\n\n    if a1 == b1 == 0:\n\n        if c1 == 0:\n\n            return plane(a2, b2, c2)\n\n        else:\n\n            return 0\n\n    if a1 == 0:\n\n        return hline(b1, c1, a2, b2, c2)\n\n    if b1 == 0:\n\n        return vline(a1, c1, a2, b2, c2)\n\n    if a2 == b2 == 0:\n\n        if c2 == 0:\n\n            return plane(a1, b1, c1)\n\n        else:\n\n            return -1\n\n    if a2 == 0:\n\n        return hline(b2, c2, a1, b1, c1)\n\n    if b2 == 0:\n\n        return vline(a2, c2, a1, b1, c1)\n\n    else:\n\n        if a1 * b2 == a2 * b1:\n\n            if c1 * a2 == c2 * a1:\n\n                return -1\n\n            else:\n\n                return 0\n\n        else:\n\n            return 1\n\n\n\n\n\n\n\n\n\na1, b1, c1 = map(int, input().split())\n\na2, b2, c2 = map(int, input().split())\n\n\n\nprint(intersect(a1, b1, c1, a2, b2, c2))\n\n\n",
