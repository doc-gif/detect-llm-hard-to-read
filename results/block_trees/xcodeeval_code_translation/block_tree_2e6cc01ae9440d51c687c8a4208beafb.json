    "code": " from sys import stdin, stdout\n\n\n\n\n\ndef check(m, k):\n\n    for i in range(2, int(m ** 0.5) + 1):\n\n        if not m % i and (i >= k or m // i >= k):\n\n            return 1\n\n    else:\n\n        return 0\n\n\n\n\n\nn, m, k = map(int, stdin.readline().split())\n\n\n\nif m < 2 * k or (k != 1 and not check(m, k)):\n\n    stdout.write('Marsel')\n\nelif n % 2:\n\n    stdout.write('Timur')\n\nelse:\n\n    stdout.write('Marsel')",
