    "code": " import time\n\nimport random\n\nW = int(input())\n\nM = [int(a) for a in input().split()]\n\nA = [0] * 8\n\nsTime = time.time()\n\n\n\ns = 0\n\nmi = 10**20\n\nfor i in range(8):\n\n    if s + M[i]*(i+1) <= W:\n\n        s += M[i]*(i+1)\n\n        A[i] = M[i]\n\n    else:\n\n        t = (W-s)//(i+1)\n\n        s += t*(i+1)\n\n        A[i] += t\n\n    \n\n    if s <= W:\n\n        mi = min(mi, W-s)\n\n\n\nwhile time.time() - sTime < 1.7:\n\n    i = random.randrange(8)\n\n    a = random.randrange(2)\n\n    if W-s >= 20 or (s-W < 10 and a == 0):\n\n        if A[i] < M[i]:\n\n            A[i] += 1\n\n            s += (i+1)\n\n    else:\n\n        if A[i] > 0:\n\n            A[i] -= 1\n\n            s -= (i+1)\n\n\n\n    if s <= W:\n\n        mi = min(mi, W-s)\n\n\n\nprint(W-mi)",
