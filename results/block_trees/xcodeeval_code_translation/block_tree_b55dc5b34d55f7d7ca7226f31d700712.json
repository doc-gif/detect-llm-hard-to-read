    "code": " def main():\n\n    from math import sqrt\n\n    m, n, k = map(int, input().split())\n\n    if n < m:\n\n        n, m = m, n\n\n    lo, hi = 1, k + 1\n\n    while lo + 1 < hi:\n\n        mid = (lo + hi) // 2\n\n        t = mid - 1\n\n        v = min(int(sqrt(t)), m)\n\n        tn, tm = (t - 1) // m, t // n\n\n        vv = [t // i for i in range(tm + 1, v + 1)]\n\n        if t // n * (n + m) + sum(vv) * 2 + max(min((tn - tm), len(vv)) * m, 0) - v * v - sum(\n\n                vv[:max(min(tn - tm, len(vv)), 0)]) < k:\n\n            lo = mid\n\n        else:\n\n            hi = mid\n\n    print(lo)\n\n\n\n\n\nif __name__ == '__main__':\n\n    main()\n",
