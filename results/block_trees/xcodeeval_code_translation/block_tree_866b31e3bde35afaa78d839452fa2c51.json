    "code": " n, m = map(int, input().split())\n\ndp = [0] * (n + 2)\n\ns = [0] * (n + 2)\n\ndp[n] = 1\n\ns[n] = 1\n\nfor i in range(n-1, 0, -1):\n\n    dp[i] = s[i+1]\n\n    for j in range(2, n // i + 1):\n\n        # add sum from i*j to i*(j+1) - 1\n\n        # from cells divided by j\n\n        h = min(n + 1, (i + 1) * j)\n\n        dp[i] = (dp[i] + s[i * j] - s[h]) % m\n\n        # print(\"  i=\",i,\"j=\", j, \"h=\",h)\n\n    s[i] = (s[i+1] + dp[i]) % m\n\n    # print (\"i=\", i)\n\n    # print(\"dp:\", * dp)\n\n    # print(\"s:\", *s)\n\nprint(dp[1])\n\n\n",
