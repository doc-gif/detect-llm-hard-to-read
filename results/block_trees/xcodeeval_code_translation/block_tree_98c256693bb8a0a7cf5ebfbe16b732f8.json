    "code": " n, m = map(int, input().split(' '))\n\nG = [[0]*n for i in range(n)]\n\n\n\nfor i in range(m):\n\n    u, v = map(lambda x:int(x)-1, input().split(' '))\n\n    G[u][v] = G[v][u] = 1\n\n\n\ns = [' ']*n\n\n\n\nfor i in range(n):\n\n    if G[i].count(1) == n-1:\n\n        s[i] = 'b'\n\n\n\ntry:\n\n    anode = s.index(' ')\n\n    s[anode] = 'a'\n\nexcept:\n\n    print('Yes')\n\n    print(''.join(s))\n\n    exit()\n\n\n\nfor i in range(n):\n\n    if s[i] == ' ' and G[anode][i] == 1:\n\n        s[i] = 'a'\n\n    elif s[i] == ' ' and G[anode][i] == 0:\n\n        s[i] = 'c'\n\n\n\nfor i in range(n):\n\n    for j in range(i+1, n):\n\n        if (s[i] != s[j] and s[i] != 'b' and s[j] != 'b') == G[i][j]:\n\n                print('No')\n\n                exit()\n\n\n\nprint('Yes')\n\nprint(''.join(s))\n",
