    "code": " def getLine():\n\n    return list(map(int,input().split()))\n\n\n\ndef val(s,c):\n\n    \n\n    ssum = 0\n\n    ssum+=s.count('+')\n\n    ssum-=s.count('-')\n\n\n\n    return ssum\n\n\n\ndef val2(s,c):\n\n    ssum = 0\n\n    ssum+=s.count('1')\n\n    ssum-=s.count('0')\n\n\n\n    ssum-=(c - len(s))\n\n\n\n    return ssum\n\n\n\ndef main():\n\n    send = input()\n\n    recv = input()\n\n\n\n    needed_val = val(send,len(send))\n\n    rval = val(recv,len(recv))\n\n\n\n    \n\n    # print(send)\n\n    if '?' not in recv:\n\n        if needed_val== rval:\n\n            print(1)\n\n            return\n\n        else:\n\n            print(0)\n\n            return\n\n\n\n    ques = recv.count('?')\n\n    fav = 0\n\n    \n\n    # print(needed_val, rval)\n\n    for i in range(2**ques):\n\n        tmp = val2(bin(i)[2:],ques) + rval   \n\n        # print(tmp) \n\n        # print(tmp)    \n\n        if tmp == needed_val:\n\n            fav+=1\n\n        \n\n            \n\n    # print(fav)\n\n    print(fav/pow(2,ques))\n\n    \n\n\n\n\n\nmain()",
    "block_tree": {
      "block_code": " def getLine():\n    return list(map(int,input().split()))\ndef val(s,c):\n    ssum = 0\n    ssum+=s.count('+')\n    ssum-=s.count('-')\n    return ssum\ndef val2(s,c):\n    ssum = 0\n    ssum+=s.count('1')\n    ssum-=s.count('0')\n    ssum-=(c - len(s))\n    return ssum\ndef main():\n    send = input()\n    recv = input()\n    needed_val = val(send,len(send))\n    rval = val(recv,len(recv))\n    # print(send)\n    if '?' not in recv:\n        if needed_val== rval:\n            print(1)\n            return\n        else:\n            print(0)\n            return\n    ques = recv.count('?')\n    fav = 0\n    # print(needed_val, rval)\n    for i in range(2**ques):\n        tmp = val2(bin(i)[2:],ques) + rval   \n        # print(tmp) \n        # print(tmp)    \n        if tmp == needed_val:\n            fav+=1\n    # print(fav)\n    print(fav/pow(2,ques))\nmain()",
