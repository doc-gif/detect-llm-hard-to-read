    "code": " def f(n):\n\n    if n == 0:\n\n        return 0\n\n    return 2**(n-1) + 2*f(n-1)\n\n\n\nf = [0]*60\n\n\n\nfor n in range(1, 60):\n\n    f[n] = 2**(n-1) + 2*f[n-1]\n\n\n\nn = int(input())\n\n\n\nans = 0\n\n\n\nfor k in range(60, 0, -1):\n\n    if n >= 2**k:\n\n        ans += f[k]\n\n        n -= 2**k\n\n        if n > 0:\n\n            ans += 2**k\n\n\n\nprint(int(ans))",
