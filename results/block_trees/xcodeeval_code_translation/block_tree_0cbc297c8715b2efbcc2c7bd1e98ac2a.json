    "code": " import sys\n\n\n\ninput_ = sys.stdin.readline\n\n\n\n\n\ndef precompute_places():\n\n    res = {}\n\n\n\n    for i in range(476):\n\n        res[i] = get_tshirt_winners(i)\n\n\n\n    return res\n\n\n\n\n\ndef get_tshirt_winners(i):\n\n    winners = set()\n\n\n\n    for _ in range(25):\n\n        i = (i * 96 + 42) % 475\n\n        winners.add(i + 26)\n\n\n\n    return winners\n\n\n\n\n\ndef can_haz_tshirt(s, p, places):\n\n    i = (s // 50) % 475\n\n\n\n    if p in places[i]:\n\n        return True\n\n    return False\n\n\n\n\n\ndef main():\n\n    p, x, y = map(int, input_().split())\n\n\n\n    places = precompute_places()\n\n\n\n    x_down = x\n\n    while x_down >= y:\n\n        if can_haz_tshirt(x_down, p, places):\n\n            return 0\n\n        x_down -= 50\n\n\n\n    x += 100\n\n    successes = 1\n\n    for _ in range(476):\n\n        if can_haz_tshirt(x, p, places) or can_haz_tshirt(x - 50, p, places):\n\n            return successes\n\n\n\n        x += 100\n\n        successes += 1\n\n\n\n    return -1\n\n\n\n\n\nif __name__ == '__main__':\n\n    print(main())\n",
