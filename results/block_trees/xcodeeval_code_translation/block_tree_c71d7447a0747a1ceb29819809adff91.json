    "code": " # Prime factorization\n\ndef prime_factorization(x):\n\n    answer = []\n\n    i = 2\n\n    while i*i <= x:\n\n        if x%i == 0:\n\n            answer.append(i)\n\n            while x%i == 0: x //= i\n\n        i += 1\n\n    if x > 1: answer.append(x)\n\n    return answer\n\n \n\n# Main\n\ndef main(X: int, N: int):\n\n    answer = 1\n\n    mod = 10**9 + 7\n\n    x_primes = prime_factorization(x)\n\n    for prime in x_primes:\n\n        power = 0\n\n        factor = prime\n\n        while factor <= N:\n\n            power += N // factor\n\n            factor *= prime\n\n        #print(\"power is:\", power)\n\n        answer *= pow(prime, power, mod)\n\n        answer %= mod\n\n    return answer\n\n \n\nx, n = [int(c) for c in input().split()]\n\nprint(main(x, n))",
