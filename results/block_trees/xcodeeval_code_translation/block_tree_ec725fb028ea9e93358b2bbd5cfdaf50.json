    "code": " def Count (n):\n\n    cnt = 0\n\n    x = 1\n\n    while True:\n\n        if x > n:\n\n            break\n\n        y = 1\n\n        while True:\n\n            if x * y > n:\n\n                break\n\n            cnt += 1\n\n            y *= 3\n\n        x *= 2\n\n    return cnt\n\n\n\ndef Result (l, r):\n\n    if l == 0:\n\n        return Count (r)\n\n    return Count (r) - Count (l - 1)\n\n\n\nl, r = map (int, input ().split ())\n\nprint (Result (l, r))",
