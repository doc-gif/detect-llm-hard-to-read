    "code": " __copyright__ = ''\n\n__author__ = 'Son-Huy TRAN'\n\n__email__ = \"sonhuytran@gmail.com\"\n\n__doc__ = ''\n\n__version__ = '1.0'\n\n\n\n\n\ndef main() -> int:\n\n    (n, d) = map(int, input().split())\n\n    costs = sorted([int(word) for word in input().split()])\n\n    m = int(input())\n\n    profit = 0\n\n\n\n    if m <= n:\n\n        profit = sum(costs[:m])\n\n    else:\n\n        profit = sum(costs) - (m - n) * d\n\n\n\n    print(profit)\n\n    return 0\n\n\n\n\n\nif __name__ == '__main__':\n\n    exit(main())",
