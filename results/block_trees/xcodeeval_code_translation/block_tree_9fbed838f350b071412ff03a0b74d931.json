    "code": " n, k = map(int, input().split())\n\nif n == k or k == 0:\n\n    print(0, 0)\n\nelse:\n\n    if n % 3 == 0:\n\n        t = n // 3\n\n        if k <= t:\n\n            print(1, k * 2)\n\n        else:\n\n            print(1, t * 3 - k)\n\n    elif n % 3 == 1:\n\n        t = n // 3\n\n        if k <= t:\n\n            print(1, k * 2)\n\n        else:\n\n            print(1, t * 3 - k + 1)\n\n    else:\n\n        t = n // 3\n\n        if k <= t:\n\n            print(1, k * 2)\n\n        else:\n\n            print(1, t * 3 - k + 2)\n",
