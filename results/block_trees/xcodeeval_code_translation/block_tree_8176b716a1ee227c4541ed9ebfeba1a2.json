    "code": " import math\n\n\n\n\n\nclass CodeforcesTask1037ASolution:\n\n    def __init__(self):\n\n        self.result = ''\n\n        self.n = 0\n\n\n\n    def read_input(self):\n\n        self.n = int(input())\n\n\n\n    def process_task(self):\n\n        res = 0\n\n        while self.n >= 2 ** res:\n\n            self.n -= 2 ** res\n\n            res += 1\n\n        if self.n:\n\n            res += 1\n\n        self.result = str(res)\n\n\n\n    def get_result(self):\n\n        return self.result\n\n\n\n\n\nif __name__ == \"__main__\":\n\n    Solution = CodeforcesTask1037ASolution()\n\n    Solution.read_input()\n\n    Solution.process_task()\n\n    print(Solution.get_result())\n",
