    "code": " def solve(str,n,k):\n\n    g=str.index('G')\n\n    t=str.index('T')\n\n    if g>t:\n\n        for i in range(t,g+1,k):\n\n            if str[i]=='G':\n\n                return True\n\n            if str[i]=='#':\n\n                return False\n\n    else:\n\n        for i in range(g,t+1,k):\n\n            if str[i]=='T':\n\n                return True\n\n            if str[i]=='#':\n\n                return False\n\n    return False\n\n            \n\n\n\nstrnk=(input())\n\nstr1=strnk.split(\" \")\n\nn=int(str1[0])\n\nk=int(str1[1])\n\nstr=input()\n\nif solve(str,n,k)==True:\n\n    print(\"YES\")\n\nelse:\n\n    print(\"NO\")\n",
