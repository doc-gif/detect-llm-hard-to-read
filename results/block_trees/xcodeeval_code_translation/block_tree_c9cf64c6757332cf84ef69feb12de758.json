    "code": " k = int(input())\n\n\n\na = []\n\nsum = []\n\nfor i in range(1, 10):\n\n    a.append(i)\n\n    sum.append(i)\n\nans = -1\n\nwhile ans == -1:\n\n    A = []\n\n    S = []\n\n    for i in range(len(a)):\n\n        for j in range(10):\n\n            if sum[i] + j <= 10:\n\n                A.append(a[i] * 10 + j)\n\n                S.append(sum[i] + j)\n\n    a = A\n\n    sum = S\n\n    for i in range(len(a)):\n\n        if sum[i] == 10:\n\n            k -= 1\n\n            if k == 0:\n\n                ans = a[i]\n\n                break\n\nprint(ans)",
