    "code": " \n\n# coding: utf-8\n\n\n\n# In[36]:\n\n\n\n\n\nimport math\n\n\n\ndef UnusualSeq(a,b):\n\n    if b%a!=0:\n\n        print(0)\n\n    else:\n\n        b//=a\n\n        d=set()\n\n        for i in range(1,int(math.sqrt(b)+1)):\n\n            if b%i==0:\n\n                d.add(i)\n\n                d.add(b//i)\n\n        d=sorted(list(d))\n\n        f=d[::]\n\n        for i in range(len(f)):\n\n            f[i]=pow(2,d[i]-1,(10**9+7))\n\n            for j in range(i):\n\n                if d[i]%d[j]==0:\n\n                    f[i]-=f[j]\n\n        print(f[-1]%(10**9+7))\n\n\n\n\n\na,b=map(int,input().split())\n\nUnusualSeq(a,b)\n\n\n",
