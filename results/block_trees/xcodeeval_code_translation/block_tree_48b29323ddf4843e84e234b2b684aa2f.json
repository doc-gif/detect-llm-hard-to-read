    "code": " import operator as op\n\nimport math\n\nfrom functools import reduce\n\n\n\ndef ncr(n, r):\n\n    r = min(r, n-r)\n\n    numer = reduce(op.mul, range(n, n-r, -1), 1)\n\n    denom = reduce(op.mul, range(1, r+1), 1)\n\n    return numer // denom\n\n\n\nn,m,t=map(int,input().split())\n\nways=0\n\na=4\n\nb=t-a\n\nwhile(a<=n and b!=0):\n\n<0x09>if(b<=m):\n\n<0x09><0x09>ways+=ncr(n,a)*ncr(m,b)\n\n<0x09>a=a+1\n\n<0x09>b=t-a\n\nprint(int(ways))\n\n<0x09>\n\n<0x09>\n\n\n",
