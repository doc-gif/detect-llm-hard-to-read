    "code": " s = input()\n\nk = int(input())\n\nle = len(s) + k\n\nm = 0\n\nfor i in range(len(s)):\n\n    j = 1\n\n    while i+2*j <= le:\n\n        mi = i + j\n\n        la = i + 2*j\n\n        if mi >= len(s):\n\n            m = max(m, j)\n\n        if la <= len(s) and s[i:mi] == s[mi:la]:\n\n            m = max(m, j)\n\n        if mi < len(s):\n\n            xl = len(s) - mi\n\n            if s[i:i + xl] == s[mi:len(s)]:\n\n                m = max(m, j)\n\n        j += 1\n\nprint(2*m)\n",
