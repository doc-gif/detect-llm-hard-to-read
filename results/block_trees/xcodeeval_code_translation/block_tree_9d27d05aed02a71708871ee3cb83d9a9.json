    "code": " from sys import stdin\n\n\n\n\n\nn = int(stdin.readline())\n\n\n\n\n\ndef eq(m1, m2):\n\n    for i in range(n):\n\n        if m1[i] != m2[i]:\n\n            return False\n\n    return True\n\n\n\n\n\ndef fleq(m1, m2):\n\n    return eq(m1, m2) or eq(m1, fliph(m2)) or eq(m1, flipv(m2))\n\n\n\n\n\ndef fliph(m):\n\n    return [row[::-1] for row in m]\n\n\n\n\n\ndef flipv(m):\n\n    return m[::-1]\n\n\n\n\n\ndef rot(m):\n\n    mr = ['' for _ in range(n)]\n\n    for i in range(n):\n\n        x = ''\n\n        for j in range(n):\n\n            x = x + m[j][n-i-1]\n\n        mr[i] = x\n\n    return mr\n\n\n\n\n\nu = [stdin.readline()[:-1] for _ in range(n)]\n\nv = [stdin.readline()[:-1] for _ in range(n)]\n\nv90 = rot(v)\n\nv180 = rot(v90)\n\nv270 = rot(v180)\n\n\n\nif fleq(u, v) or fleq(u, v90) or fleq(u, v180) or fleq(u, v270):\n\n    print('Yes')\n\nelse:\n\n    print('No')\n",
