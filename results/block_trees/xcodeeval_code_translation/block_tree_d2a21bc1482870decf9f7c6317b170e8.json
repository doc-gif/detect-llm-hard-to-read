    "code": " def pixel(input):\n\n    red, green, blue = input.split()\n\n    red = int(red)\n\n    green = int(green)\n\n    blue = int(blue)\n\n\n\n    plist = [red,green,blue]\n\n    plist.sort()\n\n\n\n    lowestChet = is_chet(plist[0])\n\n    midChet = is_chet(plist[1])\n\n\n\n    if ((midChet + lowestChet) == 2) or ((midChet + lowestChet) == 0):\n\n        return plist[1]\n\n    else:\n\n        return plist[2]\n\n\n\n\n\ndef is_chet(n):\n\n    return 1 if n % 2 == 0 else 0\n\n    \n\nprint(pixel(input()))",
