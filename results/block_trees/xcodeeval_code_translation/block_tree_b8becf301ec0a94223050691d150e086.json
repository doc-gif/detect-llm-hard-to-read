    "code": " global dp\n\ndef solve(a,l,r,d):\n\n    if r-l+1 <= 1:\n\n        return 0\n\n    curD = a[r]-a[l]\n\n    if curD <= d:\n\n        return 0\n\n    if dp[l][r]!=-1:\n\n        return dp[l][r]\n\n    \n\n    dp[l][r] = min( 1+solve(a,l+1,r,d), 1+solve(a,l,r-1,d) ) \n\n    return dp[l][r]\n\n\n\ndp = [[ -1 for i in range(100)] for j in range(100)]\n\nn, d = map(int,input().split())\n\na = list(map(int,input().split()))\n\na = sorted(a)\n\nans = solve(a,0,n-1,d)\n\nprint(ans)\n",
