    "code": " memo = {}\n\nn = int(input())\n\na = [s for s in input().split()]\n\n\n\ndef ok(c1, c2):\n\n    return (c1[0] == c2[0]) or (c1[1] == c2[1])\n\n\n\ndef dfs(i, c1, c2, c3):\n\n    k = (i, c1, c2, c3)\n\n    if k in memo:\n\n        return memo[k]\n\n    if i < 0:\n\n        memo[k] = ok(c1, c2) and ok(c1, c3)\n\n    else:\n\n        r = False\n\n        if ok(c1, a[i]):\n\n            r = r or dfs(i - 1, c2, c3, c1)\n\n        if ok(c1, c2):\n\n            r = r or dfs(i - 1, c1, c3, a[i])\n\n        memo[k] = r\n\n    return memo[k]\n\n\n\ndef check():\n\n    if n == 1:\n\n        return True;\n\n    elif n == 2:\n\n        return ok(a[1], a[0])\n\n    else:\n\n        return dfs(n - 4, a[-1], a[-2], a[-3])\n\n\n\nprint('YES' if check() else 'NO')\n\n\n\n\n\n\n\n\n\n# Made By Mostafa_Khaled",
