    "code": " def Solve(x,B):\n\n    if((X,x,B) in Mem):\n\n        return Mem[(X,x,B)]\n\n    if(len(B)>X):\n\n        return False\n\n    if(x==len(L)):\n\n        return True\n\n    if(Form(L[x],B)):\n\n        A=list(B)\n\n        for e in range(len(B)):\n\n            r=A[e]\n\n            A[e]=L[x]\n\n            if(Solve(x+1,tuple(sorted(A)))):\n\n                Mem[(X,x,B)]=True\n\n                return True\n\n            A[e]=r\n\n        A+=[L[x]]\n\n        if(Solve(x+1,tuple(sorted(A)))):\n\n            Mem[(X,x,B)]=True\n\n            return True\n\n    Mem[(X,x,B)]=False\n\n    return False\n\n\n\ndef Form(x,B):\n\n    for i in range(len(B)):\n\n        for j in range(i,len(B)):\n\n            if(B[i]+B[j]==x):\n\n                return True\n\n    return False\n\n        \n\nn=int(input())\n\nL=list(map(int,input().split()))\n\ndone=False\n\nMem={}\n\nfor X in range(1,n+1):\n\n    if(Solve(1,(L[0],))):\n\n        print(X)\n\n        done=True\n\n        break\n\nif(not done):\n\n    print(-1)\n",
