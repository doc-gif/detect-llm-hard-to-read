    "code": " def reflection(num):\n\n    tmp = []\n\n    numlist = list(str(num))\n\n    for el in numlist:\n\n        i = int(el)\n\n        ni = 9-i\n\n        if ni == 0 and len(tmp) == 0:\n\n            continue\n\n        tmp.append(str(ni))\n\n    if not tmp:\n\n        return 0\n\n    return int(\"\".join(tmp))\n\n    \n\ndef solve(l, r):\n\n    result = 0\n\n    result = max(result, l*reflection(l))\n\n    result = max(result, r*reflection(r))\n\n\n\n    start = 0\n\n    while 5*(10**start) <= l:\n\n        start += 1\n\n    \n\n    while 5*(10**start) <= r:\n\n        cur_num = 5*(10**start)\n\n        result = max(result, cur_num*reflection(cur_num))\n\n        start += 1\n\n    return result\n\n\n\n\n\nl, r = map(int, input().split())\n\nresult = solve(l, r)\n\nprint(result)\n",
