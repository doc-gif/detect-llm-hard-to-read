    "code": " a = list(map(int,input().split()))\n\nmaxi = -1\n\nfor i in range(14):\n\n    s = 0\n\n    if a[i] != 0:\n\n        cel = a[i] // 14\n\n        ost = a[i] % 14\n\n\n\n        for ty in range(1,14):\n\n            if i + ty > 13:\n\n                i -= 14\n\n            su = a[i + ty] + cel\n\n            if ty <= ost:\n\n                su += 1\n\n            if su % 2 == 0:\n\n                s += su\n\n        if cel % 2 == 0:\n\n            s += cel\n\n    if s > maxi:\n\n        maxi = s\n\nprint(maxi)\n",
