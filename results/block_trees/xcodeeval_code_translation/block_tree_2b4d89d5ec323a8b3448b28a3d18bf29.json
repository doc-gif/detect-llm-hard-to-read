    "code": " import sys\n\n\n\ndef solve():\n\n    a, b = map(int, input().split())\n\n    c, d = map(int, input().split())\n\n\n\n    if b < d:\n\n        a, c = c, a\n\n        b, d = d, b\n\n\n\n    for i in range(c):\n\n        if (b - d + i*a) % c == 0:\n\n            ans = b + i*a\n\n            print(ans)\n\n            return\n\n\n\n    print(-1)\n\n\n\nif __name__ == '__main__':\n\n    solve()",
