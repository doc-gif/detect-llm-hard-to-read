    "code": " #!/usr/bin/env python3\n\n# -*- coding: utf-8 -*-\n\n\"\"\"\n\nCreated on Mon Sep 17 14:55:08 2018\n\n\n\n@author: chenzixuan\n\n\"\"\"\n\n\n\ndef gcd(a,b):\n\n    while (a!=0 and b!=0):\n\n        t = a%b\n\n        a = b\n\n        b = t\n\n    return a\n\n\n\ndef main():\n\n    #print(list(map(int,str.split(input()))))\n\n\n\n    [a,b,x,y] = list(map(int,str.split(input())))\n\n    tmp = gcd(x,y)\n\n    x /= tmp\n\n    y /= tmp\n\n    ans = min(int(a/x), int(b/y))\n\n    print(ans)\n\n    \n\n    \n\nif __name__ == '__main__':\n\n    main()\n\n    ",
