    "code": " import sys\n\nlines = sys.stdin.readlines()\n\nn = int(lines[0].strip())\n\nquery = []\n\nfor i in range(1, n+1):\n\n    (a, b, c) = lines[i].strip().split(\" \")\n\n    query.append((a, int(b), int(c)))\n\ndef compare(i):\n\n    digits = str(i)\n\n    digits = \"0\" *(4-len(digits)) + digits\n\n    if len(set(list(digits))) != 4: return False\n\n    for q in query:\n\n        (a, b, c) = q\n\n        m, n = 0, 0\n\n        for i in range(4):\n\n            if a[i] == digits[i]: m += 1\n\n        for l in a:\n\n            if l in digits: n += 1\n\n        n -= m\n\n        if m != b or n != c:\n\n            return False\n\n    return True\n\nres = 0\n\ncount = 0\n\nfor i in range(123, 9877):\n\n    if compare(i): count += 1; res = i\n\n    if count >= 2: break\n\nif count == 0: print(\"Incorrect data\")\n\nelif count == 1:\n\n    digits = str(res)\n\n    digits = \"0\" *(4-len(digits)) + digits\n\n    print(digits)\n\nelse: print(\"Need more data\")\n",
