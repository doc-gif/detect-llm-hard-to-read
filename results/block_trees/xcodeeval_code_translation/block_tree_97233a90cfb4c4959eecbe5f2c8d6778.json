    "code": " def get_input():\n\n    num = input()\n\n    line = input()\n\n    test_cases = line.split()\n\n    result = []\n\n    for i in test_cases:\n\n        result.append(int(i))\n\n    return result\n\n\n\ndef send_balls(n,l):\n\n    l = sorted(l)\n\n    l2 = l.copy()\n\n    for x in range(0,n-2):\n\n        if l[x]==l[x+1]:\n\n            l2.remove(l[x+1])\n\n    else:\n\n        for i in range(0,len(l2)-2):\n\n            if l2[i+1]-l2[i]<2 and l2[i+2]-l2[i+1]<2 and l2[i+1]!=l2[i] and l2[i+2]!=l2[i+1]:\n\n                return \"YES\"\n\n    return \"NO\"\n\n\n\n\n\ntest_cases = get_input()\n\nprint(send_balls(len(test_cases),test_cases))\n\n                \n\n            \n",
