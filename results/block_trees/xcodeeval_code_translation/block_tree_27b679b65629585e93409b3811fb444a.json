    "code": " import sys\n\nfrom math import factorial\n\n\n\ninput = sys.stdin.readline\n\n\n\ndef A(n, k):\n\n<0x09>return factorial(n)//factorial(n-k)\n\n\n\ndef solve():\n\n<0x09>n, mod = map(int, input().split())\n\n<0x09>if n == 1:\n\n<0x09><0x09>print(0)\n\n<0x09><0x09>return\n\n<0x09>z = [1]\n\n<0x09>aaa = 0\n\n<0x09>for i in range(2,n+1):\n\n<0x09><0x09>nz = [0]*((i-1)*i//2+1)\n\n<0x09><0x09>d = [0]*(len(z)+1)\n\n<0x09><0x09>for w in range(len(z)-1, -1, -1):\n\n<0x09><0x09><0x09>d[w] = (d[w+1] + z[w]) % mod\n\n<0x09><0x09>for w in range(len(nz)):\n\n<0x09><0x09><0x09>#d = 0\n\n<0x09><0x09><0x09>#for j in range(max(0,w+1-i), min(len(z),w+1)):\n\n<0x09><0x09><0x09>#<0x09>d = (d + z[j]) % mod\n\n<0x09><0x09><0x09>#nz[w] = d\n\n<0x09><0x09><0x09>L = max(0,w+1-i)\n\n<0x09><0x09><0x09>R = min(len(z)-1,w)\n\n<0x09><0x09><0x09>nz[w] = d[L]-d[R+1]\n\n<0x09><0x09>e = [0]*(len(d)+1)\n\n<0x09><0x09>f = [0]*(len(d)+1)\n\n<0x09><0x09>for w in range(0, len(e)-1):\n\n<0x09><0x09><0x09>e[w+1] = (e[w] + d[w]) % mod\n\n<0x09><0x09><0x09>f[w+1] = (f[w] - w * d[w]) % mod\n\n<0x09><0x09>R = len(z)\n\n<0x09><0x09>bbb = 0\n\n<0x09><0x09>for jj in range(max(0,len(z)-i), len(z)-2):\n\n<0x09><0x09><0x09>L = jj + 2\n\n<0x09><0x09><0x09>bbb = (bbb + ((e[R] - e[L]) * (i+1+jj) \\\n\n<0x09><0x09><0x09><0x09>+ (f[R] - f[L])) * z[jj]) % mod\n\n<0x09><0x09>for jj in range(len(z)-i):\n\n<0x09><0x09><0x09>L = jj + 2\n\n<0x09><0x09><0x09>R = i + jj\n\n<0x09><0x09><0x09>bbb = (bbb + ((e[R+1] - e[L]) * (i+1+jj) \\\n\n<0x09><0x09><0x09><0x09>+ (f[R+1] - f[L])) * z[jj]) % mod\n\n<0x09><0x09>#print(bbb)\n\n<0x09><0x09>aaa += (bbb * A(n,n-i)) % mod\n\n<0x09><0x09>#print(nz)\n\n<0x09><0x09>z = nz\n\n<0x09>#print(z)\n\n<0x09>print(aaa % mod)\n\n\n\nsolve()\n",
