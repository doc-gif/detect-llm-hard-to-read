    "code": " x = input().split()      \n\n \n\nhazZero = False\n\n\n\nbinary = bin(int(x[0]))\n\nbinary = binary[2:]\n\n\n\nfor i in range(len(binary)):\n\n    if (binary[i] == '0'):\n\n        hazZero = True\n\n\n\nif (not hazZero):\n\n    binary = bin(int(x[0]) + 1)\n\n    binary = binary[2:]\n\n \n\nisFirst = True\n\nnew_binary = ''\n\n \n\nfor i in range(len(binary)):\n\n    if (binary[i] == '0'):\n\n        if (isFirst):\n\n            new_binary = new_binary + '0'\n\n            isFirst = False\n\n        else:\n\n            new_binary = new_binary + '1'\n\n    else:          \n\n        new_binary = new_binary + binary[i]\n\n \n\ninDecimal = int(new_binary, 2)\n\n \n\ntotal = 0\n\n \n\nwhile (int(x[0]) <= inDecimal and inDecimal <= int(x[1]) ):\n\n    total += 1\n\n    if (new_binary == '1'):\n\n        total -= 1\n\n        new_binary = '10'\n\n    elif (new_binary[-1] == '0'):\n\n        new_binary = '10' + new_binary[:-1]\n\n    else:    \n\n        new_binary = '1' + new_binary[:-1]\n\n    inDecimal = int(new_binary, 2)\n\n \n\nprint(total)",
