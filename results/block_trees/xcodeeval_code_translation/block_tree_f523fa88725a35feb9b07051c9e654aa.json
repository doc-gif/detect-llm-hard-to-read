    "code": " def check(s, i):\n\n  if i == len(s):\n\n    x = ''.join(s)\n\n    if x[0] == '0' and x != '0':\n\n      return 0\n\n    if int(x)%25 == 0:\n\n      return 1\n\n    return 0\n\n  res = 0\n\n  if s[i] == '_':\n\n    if i != 0 and i<len(s)-2:\n\n      s[i] = '1'\n\n      res += 10*check(s, i+1)\n\n    else:\n\n      for j in range(10):\n\n        s[i] = str(j)\n\n        res += check(s, i+1)\n\n    s[i] = '_'\n\n    return res\n\n  else:\n\n    return check(s, i+1)\n\n \n\n \n\ninp = input()\n\ntotal = 0\n\nif 'X' in inp:\n\n  for i in range(10):\n\n    s = inp\n\n    s = s.replace('X', str(i))\n\n    total += check(list(s), 0)\n\nelse: total = check(list(inp), 0)\n\n \n\nprint(total)\n",
