    "code": " def prefix(s):\n\n    v = [0]*len(s)\n\n    for i in range(1,len(s)):\n\n        k = v[i-1]\n\n        while k > 0 and s[k] != s[i]:\n\n            k = v[k-1]\n\n        if s[k] == s[i]:\n\n            k = k + 1\n\n        v[i] = k\n\n    return v\n\n\n\nn = int(input())\n\nn-=1\n\ns1 = input()\n\ns2 = input()\n\nopos = {'W':'E', 'E':'W', 'N':'S', 'S':'N'}\n\ns3 = ''\n\nfor elem in s2:\n\n    s3 += opos[elem]\n\n    \n\ns3  = s3[::-1]\n\ns = s3 + '$' + s1\n\n\n\na = prefix(s)[2 * n]\n\nif a == 0: print('YES')\n\nelse: print('NO')\n\n\n",
