    "code": " MOD = 1000000007\n\n\n\ndef calc(n, m, k):\n\n    if k == -1 and n%2 != m%2:\n\n        return 0\n\n    n = (n-1)\n\n    m = (m-1)\n\n    n = (n * m)\n\n    r = 1\n\n    s = 2\n\n    while n > 0:\n\n        if n % 2 == 1:\n\n            r = (r*s) % MOD\n\n        n //= 2\n\n        s = (s*s) % MOD\n\n    return r\n\n\n\n\n\nif __name__ == '__main__':\n\n    n, m, k = input().split(' ')\n\n    print(calc(int(n), int(m), int(k)))",
