    "code": " \"\"\"\n\nOh, Grantors of Dark Disgrace, \n\nDo Not Wake Me Again.\n\n\"\"\"\n\n\n\nii = lambda: int(input())\n\nmi = lambda: map(int, input().split())\n\nli = lambda: list(mi())\n\nsi = lambda: input()\n\n\n\nfrom itertools import permutations\n\n\n\nl = [[]]*5\n\nn = [0, 1, 2, 3, 4]\n\n\n\nfor i in range(5):\n\n    l[i] = li()\n\n\n\nmaxi = 0\n\n\n\nfor a, b, c, d, e in permutations(n, 5):\n\n    s = l[a][b] + l[b][a] + l[b][c] + l[c][b] + 2*(l[c][d] + l[d][c] + l[d][e] + l[e][d])\n\n    maxi = max(maxi, s)\n\n\n\nprint(maxi)",
