    "code": " INF = 10000\n\nn = input()\n\nans = INF\n\nk = len(n)\n\nfor i in range(k):\n\n    for j in range(k):\n\n        if i == j:\n\n            continue\n\n        s = n\n\n        tmp = 0\n\n        for p in range(i, k - 1):\n\n            s = s[:p] + s[p + 1] + s[p] + s[p + 2:]\n\n            tmp += 1\n\n        for p in range(j - (j > i), k - 2):\n\n            s = s[:p] + s[p + 1] + s[p] + s[p + 2:]\n\n            tmp += 1\n\n        pos = -1\n\n        for p in range(k):\n\n            if s[p] != '0':\n\n                pos = p\n\n                break\n\n        for p in range(pos, 0, -1):\n\n            s = s[:p - 1] + s[p] + s[p - 1] + s[p + 1:]\n\n            tmp += 1\n\n        if int(s) % 25 == 0:\n\n            ans = min(ans, tmp)\n\nprint(ans if ans != INF else -1)\n",
