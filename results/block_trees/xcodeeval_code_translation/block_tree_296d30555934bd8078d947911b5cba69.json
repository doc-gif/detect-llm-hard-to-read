    "code": " def main():\n\n    r1, c1, r2, c2 = map(int, input().split())\n\n    _1, _2, _3 = 2, 2, 0\n\n   \n\n    if r1 == r2 or c1 == c2:\n\n        _1 = 1\n\n    \n\n    if (r1+c1) % 2 != (r2+c2) % 2:\n\n        _2 = 0\n\n    elif r1 + c1 == r2 + c2 or r1 - c1 == r2 - c2:\n\n        _2 = 1\n\n\n\n    _3 = max(abs(r1-r2), abs(c1-c2))\n\n    print(_1, _2, _3)\n\n\n\n\n\nif __name__ == '__main__':\n\n    main()\n\n\n",
