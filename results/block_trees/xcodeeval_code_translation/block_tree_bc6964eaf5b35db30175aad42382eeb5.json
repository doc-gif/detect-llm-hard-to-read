    "code": " x, k = [int(a) for a in input().strip().split()]\n\n\n\n\n\ndef binpow(x, k, mod):\n\n    res = 1\n\n    while k > 0:\n\n        if k & 1:\n\n            res  = ( res * x ) % mod\n\n        x = ( x * x) % mod\n\n        k >>= 1\n\n    return res\n\nif x == 0:\n\n    print(0)\n\n    exit()\n\n\n\nmod = int(1e9 + 7)\n\nk2 = binpow(2, k, mod)\n\nres = ( k2 * (2 * x - 1) + 1) % mod\n\n\n\nres %= mod\n\n\n\nprint(int(res))",
