    "code": " def yoba(a, k):\n\n\n\n    if not a:\n\n\n\n        return []\n\n\n\n    elif not k:\n\n\n\n        return a\n\n\n\n    else:\n\n\n\n        m = max(a[:k + 1])\n\n        mi = a.index(m)\n\n        if m > a[0]:\n\n\n\n            a[1:mi + 1] = a[:mi]\n\n            a[0] = m\n\n            k -= mi\n\n\n\n        return [a[0]] + yoba(a[1:], k)\n\n\n\n\n\na, k = str.split(input())\n\nk = int(k)\n\n\n\nprint(str.join(\"\", yoba(list(a), k)))\n",
