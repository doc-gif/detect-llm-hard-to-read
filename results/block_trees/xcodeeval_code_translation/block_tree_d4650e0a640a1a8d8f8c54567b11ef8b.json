    "code": " import sys\n\n\n\ndef sum_(a):\n\n    return max(0, a * (a + 1) // 2)\n\n\n\ndef check(a):\n\n    if a * n <= m:\n\n        return 1\n\n    a -= 1\n\n    ans = n\n\n    t1 = a - k + 1\n\n    #print(a)\n\n    if t1 >= 0:\n\n        ans += sum_(a) - sum_(t1 - 1)\n\n    else:\n\n        ans += sum_(a)\n\n    #print(ans)\n\n    z = n - k + 1\n\n    t2 = a - z + 1\n\n    #print('ts', t2)\n\n    if t2 >= 0:\n\n        ans += sum_(a - 1) - sum_(t2 - 1)\n\n    else:\n\n        ans += sum_(a - 1)\n\n    #print(ans)\n\n    return (ans <= m)\n\n\n\ndef bins():\n\n    l = 1\n\n    r = m + 1\n\n    while l + 1 != r:\n\n        m1 = (l + r) // 2\n\n        if check(m1):\n\n            l = m1\n\n        else:\n\n            r = m1\n\n    print(l)\n\n    \n\nn, m, k = map(int, input().split())\n\n#print(check(2))\n\nbins()\n\n\n\n            \n",
