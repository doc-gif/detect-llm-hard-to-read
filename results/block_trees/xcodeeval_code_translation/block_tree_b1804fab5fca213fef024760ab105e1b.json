    "code": " from collections import Counter\n\n\n\ndef primes(n):\n\n    primfac = []\n\n    cnt = Counter()\n\n    d = 2\n\n    while d * d <= n:\n\n        while (n % d) == 0:\n\n            cnt[d] += 1\n\n            # primfac.append(d)\n\n            n //= d\n\n        d += 1\n\n    if n > 1:\n\n        cnt[n] += 1\n\n        # primfac.append(n)\n\n\n\n\n\n    return list(cnt.values())\n\n\n\n\n\ndef run():\n\n    b = int(input())\n\n    occ = primes(b)\n\n    res = 1\n\n    for e in occ:\n\n        res *= e + 1\n\n\n\n    print(res)\n\n\n\n\n\nif __name__ == '__main__':\n\n    run()\n",
