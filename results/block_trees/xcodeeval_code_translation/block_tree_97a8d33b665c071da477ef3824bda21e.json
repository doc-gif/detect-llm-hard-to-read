    "code": " from queue import Queue as Q\n\nn, x = map(int, input().split())\n\nq = Q()\n\nq.put((x, 0))\n\nwas = set()\n\nwhile not q.empty():\n\n    r = q.get()\n\n    if r[0] >= 10**(n-1):\n\n        print(r[1])\n\n        break\n\n    else:\n\n        for i in str(r[0]):\n\n            if i not in [0, 1]:\n\n                new = int(i)*r[0]\n\n                if new not in was:\n\n                    was.add(new)\n\n                    q.put((new, r[1]+1))\n\nelse:\n\n    print(-1)\n",
