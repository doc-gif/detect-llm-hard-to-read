    "code": " def lint(n):    #to find length of an integer\n\n    h = int(n)\n\n    i= 0\n\n    while(h>0):\n\n          h= int(h/10)\n\n          i=i+1\n\n    len =i\n\n    return len\n\n\n\n\n\nk =int(input())\n\nlist = [1]\n\nn=1\n\ny=1\n\nfor y in range (1,k):\n\n        n = n+1;\n\n        p= lint(n)\n\n        for i in range(p,0,-1):\n\n                e= 10**(i-1)\n\n                x = int(n/e)\n\n                z= x%10 \n\n                list.append(z)\n\n\n\n\n\n        y = y+p\n\nprint(list[k-1])\n\n\n",
