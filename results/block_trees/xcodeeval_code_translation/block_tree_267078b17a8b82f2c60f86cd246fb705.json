    "code": " import math\n\na,b= map(int,input().split())\n\nn=a+b\n\nans,l=0,1\n\nwhile l<=n:\n\n    g= n//l\n\n    if a<g or b<g:\n\n        l= (n//g) +1\n\n        continue\n\n    r= n//g\n\n    a_low = (a+g)//(g+1)\n\n    a_high = a//g\n\n    b_low=(b+g)//(g+1)\n\n    b_high = b//g\n\n    if (a_low <= a_high and b_low <= b_high):\n\n        ans += max(0,min(r,a_high+b_high)- max(l,a_low +b_low)+1)\n\n\n\n    l=r+1\n\nprint(ans)\n",
