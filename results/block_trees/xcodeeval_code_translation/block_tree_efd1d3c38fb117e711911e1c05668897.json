    "code": " #!/usr/bin/env python3\n\nfrom bisect import *\n\n\n\ndef ri():\n\n    return map(int, input().split())\n\n\n\nn, m = ri()\n\n\n\nif m-n >= 0:\n\n    print(n)\n\n    exit()\n\n\n\nk = (n-m)\n\nal = 0\n\nar = 2*k*(k+1)+1\n\n\n\nwhile ar-al > 1:\n\n    a = (al+ar)//2\n\n    aa = a*(a+1)//2\n\n    if k <= aa:\n\n        ar = a\n\n    else:\n\n        al = a\n\nprint(ar+m)\n",
