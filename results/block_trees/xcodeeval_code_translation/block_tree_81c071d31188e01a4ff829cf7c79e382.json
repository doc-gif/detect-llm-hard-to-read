    "code": " def main():\n\n    n, m = map(int, input().split())\n\n    if n > m:\n\n        print(0)\n\n        return\n\n    cnt = {}\n\n    for a in map(int, input().split()):\n\n        cnt[a] = cnt.get(a, 0) + 1\n\n    lo, hi = 1, 100\n\n    for _ in range(8):\n\n        mid, x = (lo + hi) // 2, n\n\n        for c in cnt.values():\n\n            x -= c // mid\n\n        if x > 0:\n\n            hi = mid\n\n        else:\n\n            lo = mid + 1\n\n    print(lo - 1)\n\n\n\n\n\nif __name__ == '__main__':\n\n    main()\n",
