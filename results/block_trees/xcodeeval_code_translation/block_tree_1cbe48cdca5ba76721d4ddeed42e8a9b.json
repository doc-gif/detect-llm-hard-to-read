    "code": " \"\"\"\n\nCodeforces Contest 287 Div 2 Problem C\n\n\n\nAuthor  : chaotic_iak\n\nLanguage: Python 3.4.2\n\n\"\"\"\n\n\n\n################################################### SOLUTION\n\n\n\ndef main():\n\n    h,n = read()\n\n    n -= 1\n\n    n = bin(n)[2:]\n\n    n = \"0\" * (h-len(n)) + n\n\n\n\n    s = \"\"\n\n    for i in range(h):\n\n        if i and n[i-1] == \"0\":\n\n            s += \"1\" if n[i] == \"0\" else \"0\"\n\n        else:\n\n            s += n[i]\n\n\n\n    ct = 0\n\n    for i in range(h):\n\n        ct += 1\n\n        if s[i] == \"1\": ct += 2**(h-i)-1\n\n    print(ct)\n\n\n\n#################################################### HELPERS\n\n\n\n\n\n\n\ndef read(mode=2):\n\n    # 0: String\n\n    # 1: List of strings\n\n    # 2: List of integers\n\n    inputs = input().strip()\n\n    if mode == 0: return inputs\n\n    if mode == 1: return inputs.split()\n\n    if mode == 2: return list(map(int, inputs.split()))\n\n\n\ndef write(s=\"\\n\"):\n\n    if s is None: s = \"\"\n\n    if isinstance(s, list): s = \" \".join(map(str, s))\n\n    s = str(s)\n\n    print(s, end=\"\")\n\n\n\nwrite(main())",
