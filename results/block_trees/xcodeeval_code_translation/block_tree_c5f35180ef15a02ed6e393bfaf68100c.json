    "code": " import math\n\nfrom collections import defaultdict\n\n\n\nmp = defaultdict(int)\n\n\n\n\n\ndef primeFactor(a):\n\n    i = 2\n\n    while i * i <= a:\n\n        while a % i == 0:\n\n            mp[i] += 1\n\n            a //= i\n\n        i += 1\n\n    if a > 1:\n\n        mp[a] += 1\n\n\n\n\n\ndef trailingZero(a, n):\n\n    ans = 0\n\n    while n > 0:\n\n        ans += n // a\n\n        n //= a\n\n    return ans\n\n\n\nn, b = map(int, input().split())\n\nans = int(1e50)\n\nprimeFactor(b)\n\nfor it in mp:\n\n    first = it\n\n    second = mp[it]\n\n    temp = trailingZero(first, n)\n\n    ans = min(ans, temp // second)\n\nprint(ans)\n\n\n",
