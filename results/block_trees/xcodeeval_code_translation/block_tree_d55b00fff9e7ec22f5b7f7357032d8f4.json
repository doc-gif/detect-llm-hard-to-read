    "code": " import sys\n\n\n\ndef solve():\n\n    n, k = map(int, input().split())\n\n    a = [int(i) - 1 for i in input().split()]\n\n\n\n    kinds = len(set(a))\n\n\n\n    if kinds <= k:\n\n        print(kinds)\n\n        return\n\n\n\n    books = [False] * n\n\n    have = 0\n\n    cost = 0\n\n\n\n    for i, ai in enumerate(a):\n\n        if books[ai]:\n\n            continue\n\n        else:\n\n            if have < k:\n\n                books[ai] = True\n\n                cost += 1\n\n                have += 1\n\n            else:\n\n                trash = -1\n\n                longest = -1\n\n\n\n                for j in range(n):\n\n                    if books[j]:\n\n                        if j not in a[i + 1:]:\n\n                            trash = j\n\n                            break\n\n\n\n                        m = a[i + 1:].index(j)\n\n\n\n                        if longest < m:\n\n                            longest = m\n\n                            trash = j\n\n\n\n                assert trash != -1\n\n\n\n                books[trash] = False\n\n                books[ai] = True\n\n                cost += 1\n\n\n\n        # print([i for i in range(n) if books[i]])\n\n\n\n    print(cost)\n\n\n\nif __name__ == '__main__':\n\n    solve()",
