    "code": " import math\n\ndef phi(n):\n\n    res = n\n\n    for i in range(2, int(math.sqrt(n)) + 1):\n\n        if(n % i == 0):\n\n            while(n % i == 0):\n\n                n /= i\n\n            res -= res/i\n\n    if(n > 1):\n\n        res -= int(res / n)\n\n    return res\n\nn, k = map(int, input().split())\n\nres = n\n\nk = int((k + 1) / 2)\n\nwhile(res != 1 and k != 0):\n\n    res = phi(res)\n\n    k -= 1\n\nprint(\"{}\".format(int(res % (1e9 + 7))))",
