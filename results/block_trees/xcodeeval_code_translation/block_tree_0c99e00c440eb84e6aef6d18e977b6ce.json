    "code": " import math\n\n\n\ndef prime(n):\n\n    i=2\n\n    while(i<=math.sqrt(n)):\n\n        if(n%i==0):\n\n            return i\n\n        else:\n\n            if(i==2):\n\n                i+=1\n\n            else:\n\n                i+=2\n\n    return n\n\nn=int(input())\n\nr=0\n\nwhile(n!=0):\n\n    d=prime(n)\n\n    if(d==n):\n\n        r+=1\n\n        break\n\n    else:\n\n        if(n%2==0):\n\n            r=r+n//2\n\n            break\n\n        else:           \n\n            n-=d\n\n            r+=1\n\nprint(r)\n",
