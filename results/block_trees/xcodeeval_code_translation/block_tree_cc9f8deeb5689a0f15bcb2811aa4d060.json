    "code": " x, y, z, k = [int(x) for x in input().split()]\n\n\n\ndim = sorted([x - 1, y - 1, z - 1])\n\n\n\nanswer = [0, 0, 0]\n\n\n\nfor i in range(len(dim)):\n\n    dimi = dim[i]\n\n    if dimi * (3 - i) <= k:\n\n        k = k - (dimi * (3 - i))\n\n        for j in range(i, 3):\n\n            answer[j] += dimi\n\n        for j in range(3):\n\n            dim[j] -=  dimi\n\n    else:\n\n        for j in range(i, 3):\n\n            answer[j] += k // (3 - i)\n\n        for j in range(i, (k % (3 - i)) + i):\n\n            answer[j] += 1\n\n        break\n\n\n\ntrue_ans = 1\n\n\n\nfor i in answer:\n\n    true_ans = true_ans * (i + 1)\n\n\n\nprint(true_ans)\n\n\n\n\n",
