    "code": " def valid(n1, n2, p1, p2, mid):\n\n    x = mid - mid//p1\n\n    y = mid - mid//p2\n\n    rem = mid - mid//(p1*p2)\n\n    return x < n1 or y < n2 or rem < n1+n2\n\n    \n\ndef binary_search(n1, n2, p1, p2):\n\n    l, r = 0, 1<<61\n\n    while (l <= r):\n\n        mid = l+r >> 1\n\n        if (valid(n1, n2, p1, p2, mid)):\n\n            l = mid+1\n\n        else:\n\n            r = mid-1\n\n    return l\n\n\n\ndef main():\n\n    n1, n2, p1, p2 = map(int, input().split())\n\n    print(binary_search(n1, n2, p1, p2))\n\n\n\nmain()",
