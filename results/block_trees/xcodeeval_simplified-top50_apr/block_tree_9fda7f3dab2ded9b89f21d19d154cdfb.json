    "code": " MAX = 1000001\n\nfactor = [0] * (MAX + 1)\n\n\n\n\n\ndef generate_prime_factors():\n\n    factor[1] = 1\n\n    for i in range(2, MAX):\n\n        factor[i] = i\n\n    for i in range(4, MAX, 2):\n\n        factor[i] = 2\n\n    i = 3\n\n    while i * i < MAX:\n\n        if factor[i] == i:\n\n            j = i * i\n\n            while j < MAX:\n\n                if factor[j] == j:\n\n                    factor[j] = i\n\n                j += i\n\n        i += 1\n\n\n\n\n\ndef calculate_factors_count(n):\n\n    if n == 1:\n\n        return 1\n\n    ans = 1\n\n    dup = factor[n]\n\n    c = 1\n\n    j = n // factor[n]\n\n    while j > 1:\n\n        if factor[j] == dup:\n\n            c += 1\n\n        else:\n\n            dup = factor[j]\n\n            ans *= c + 1\n\n            c = 1\n\n        j //= factor[j]\n\n    ans *= c + 1\n\n    return ans\n\n\n\n\n\ndef calc(n):\n\n    dp = [-1] * (n + 1)\n\n    dp[0] = 1\n\n    dp[1] = 1\n\n    pre = 2\n\n    generate_prime_factors()\n\n    for i in range(2, n + 1):\n\n        dp[i] = pre + calculate_factors_count(i) - 1\n\n        pre += dp[i]\n\n    return dp[n] % 998244353\n\n\n\n\n\nn = int(input())\n\nprint(calc(n))\n",
