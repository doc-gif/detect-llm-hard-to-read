    "code": " g = [0] * 111111\n\nt = [0] * 111111\n\n\n\n\n\ndef gcd(a, b):\n\n    if b == 0:\n\n        return a\n\n    return gcd(b, a % b)\n\n\n\n\n\ndef ksm(a, b, p=int(1e9 + 7)):\n\n    a %= p\n\n    ans = 1\n\n    while b > 0:\n\n        if b & 1:\n\n            ans = ans * a % p\n\n        b >>= 1\n\n        a = a * a % p\n\n    return ans\n\n\n\n\n\nMOD = int(1e9 + 7)\n\nm = int(input())\n\ninv_m = ksm(m, MOD - 2)\n\nfor j in range(m, 0, -1):\n\n    c1 = 0\n\n    tyouce = inv_m\n\n    gyouce = 0\n\n    if j == 1:\n\n        c1 = 0\n\n    else:\n\n        c1 = (m // j) * inv_m % MOD\n\n    for k in range(2, m // j + 1):\n\n        t0 = m // j // k\n\n        t1 = 0\n\n        for l in range(1, k):\n\n            if gcd(l, k) == 1:\n\n                t1 += 1\n\n        ck = t0 * t1 % MOD\n\n        for l in range(1, (m // j) % k + 1):\n\n            if gcd(l, k) == 1:\n\n                ck += 1\n\n        ck = ck * inv_m % MOD\n\n        tyouce = (tyouce + ck * t[k * j]) % MOD\n\n        gyouce = (gyouce + ck * (t[k * j] + g[k * j])) % MOD\n\n    denominator = (1 - c1 + MOD) % MOD\n\n    t[j] = tyouce * ksm(denominator, MOD - 2) % MOD\n\n    gyouce = (gyouce + inv_m + c1 * t[j]) % MOD\n\n    g[j] = gyouce * ksm(denominator, MOD - 2) % MOD\n\nprint(g[1])\n",
