    "code": " MOD = int(1e9 + 7)\n\n\n\n\n\ndef mult(l, r):\n\n    return (l * r) % MOD\n\n\n\n\n\ndef fast_exp(b, e):\n\n    if e == 0:\n\n        return 1\n\n    if e % 2 == 1:\n\n        return mult(b, fast_exp(b, e - 1))\n\n    else:\n\n        b2 = fast_exp(b, e // 2)\n\n        return mult(b2, b2)\n\n\n\n\n\nn, k = map(int, input().split())\n\nprint(n, k)\n\nfact = [1] * (n + 1)\n\nfor i in range(1, n + 1):\n\n    fact[i] = mult(i, fact[i - 1])\n\nifact = [1] * (n + 1)\n\nifact[n] = fast_exp(fact[n], MOD - 2)\n\nfor i in range(n - 1, 0, -1):\n\n    ifact[i] = mult(i + 1, ifact[i + 1])\n\n\n\n\n\ndef binom(N, K):\n\n    return mult(mult(fact[N], ifact[K]), ifact[N - K])\n\n\n\n\n\ndef get(i, j):\n\n    X = i * j\n\n    Y = (n - i) * j\n\n    Z = (n - j) * i\n\n    tot = X + Y + Z\n\n    sign = 1 if (i + j) % 2 == 0 else MOD - 1\n\n    ans = mult(sign, binom(n, j))\n\n    ans = mult(ans, binom(n, i))\n\n    ans = mult(ans, fast_exp(k, n * n - tot))\n\n    ans = mult(ans, fast_exp(k - 1, tot))\n\n    return ans\n\n\n\n\n\nans = 0\n\nfor i in range(n + 1):\n\n    for j in range(n + 1):\n\n        ans = (ans + get(i, j)) % MOD\n\nprint(ans)\n",
