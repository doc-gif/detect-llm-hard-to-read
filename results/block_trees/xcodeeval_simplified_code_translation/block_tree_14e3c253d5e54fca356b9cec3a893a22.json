    "code": " N = int(input())\n\nn = list(map(int, input().split()))\n\nif N == 1:\n\n    ans = [0, n[0]]\n\nelif N == 2:\n\n    ans = [min(n), max(n)]\n\nelse:\n\n    n.reverse()\n\n    first = max(n[0], n[1])\n\n    second = n[0] + n[1]\n\n    for i in range(2, N):\n\n        first = max(n[i] + second - first, first)\n\n        second += n[i]\n\n    ans = [second - first, first]\n\nprint(\" \".join(map(str, ans)))",
