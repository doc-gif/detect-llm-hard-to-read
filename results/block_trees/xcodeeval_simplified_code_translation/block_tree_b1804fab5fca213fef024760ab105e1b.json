    "code": " from collections import Counter\n\ndef primes(n):\n\n    factor_counts = Counter()\n\n    divisor = 2\n\n    while divisor * divisor <= n:\n\n        while n % divisor == 0:\n\n            factor_counts[divisor] += 1\n\n            n //= divisor\n\n        divisor += 1\n\n    if n > 1:\n\n        factor_counts[n] += 1\n\n    return list(factor_counts.values())\n\ndef run():\n\n    number = int(input())\n\n    exponents = primes(number)\n\n    result = 1\n\n    for exp in exponents:\n\n        result *= exp + 1\n\n    print(result)\n\nif __name__ == \"__main__\":\n\n    run()",
