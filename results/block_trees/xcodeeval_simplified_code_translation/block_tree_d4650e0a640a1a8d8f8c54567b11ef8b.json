    "code": " import sys\n\ndef sum_(a):\n\n    return max(0, a * (a + 1) // 2)\n\ndef check(a):\n\n    if a * n <= m:\n\n        return True\n\n    a -= 1\n\n    ans = n\n\n    t1 = a - k + 1\n\n    if t1 >= 0:\n\n        ans += sum_(a) - sum_(t1 - 1)\n\n    else:\n\n        ans += sum_(a)\n\n    z = n - k + 1\n\n    t2 = a - z + 1\n\n    if t2 >= 0:\n\n        ans += sum_(a - 1) - sum_(t2 - 1)\n\n    else:\n\n        ans += sum_(a - 1)\n\n    return ans <= m\n\ndef bins():\n\n    left = 1\n\n    right = m + 1\n\n    while left + 1 != right:\n\n        mid = (left + right) // 2\n\n        if check(mid):\n\n            left = mid\n\n        else:\n\n            right = mid\n\n    print(left)\n\nn, m, k = map(int, input().split())\n\nbins()",
