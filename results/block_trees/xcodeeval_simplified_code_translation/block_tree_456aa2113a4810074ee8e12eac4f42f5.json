    "code": " def get_power(data, exponent):\n\n    low = 0\n\n    high = data\n\n    while low <= high:\n\n        mid = (low + high) // 2\n\n        power_value = mid**exponent\n\n        if power_value < data:\n\n            low = mid + 1\n\n        elif power_value == data:\n\n            return mid\n\n        else:\n\n            high = mid - 1\n\n    return low - 1\n\ndef process_case():\n\n    data = int(input())\n\n    square_root = get_power(data, 2)\n\n    cube_root = get_power(data, 3)\n\n    sixth_root = get_power(data, 6)\n\n    result = square_root + cube_root - sixth_root\n\n    print(result)\n\ndef main():\n\n    n = int(input())\n\n    for _ in range(n):\n\n        process_case()\n\nif __name__ == \"__main__\":\n\n    main()",
