    "code": " def fi(n):\n\n    if n == 1:\n\n        return x\n\n    if n == 2:\n\n        return x + min(x, y)\n\n    if n % 2 == 1:\n\n        return min(fi(n - 1), fi(n + 1)) + x\n\n    else:\n\n        return fi(n // 2) + min(y, x * (n // 2))\n\nn, x, y = map(int, input().split())\n\nprint(fi(n))",
