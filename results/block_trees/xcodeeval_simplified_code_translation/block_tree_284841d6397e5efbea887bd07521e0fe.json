    "code": " def main():\n\n    n = int(input()) + 1\n\n    s = \" \" + input().strip()\n\n    positions = [[0, 0] for _ in range(n)]\n\n    x, y = 0, 0\n\n    ans = 0\n\n    for i in range(len(s)):\n\n        if s[i] == \"U\":\n\n            y += 1\n\n        elif s[i] == \"D\":\n\n            y -= 1\n\n        elif s[i] == \"L\":\n\n            x -= 1\n\n        elif s[i] == \"R\":\n\n            x += 1\n\n        positions[i] = [x, y]\n\n        for j in range(i):\n\n            if positions[j] == positions[i]:\n\n                ans += 1\n\n    print(ans)\n\nmain()",
