    "code": " import math\n\nn = int(input())\n\nif n % 2 == 0:\n\n    l = n / 2\n\nelse:\n\n    l = (n + 1) / 2\n\nmax_value = 0\n\na1 = 0\n\nb1 = 0\n\nfor i in range(int(l)):\n\n    a = i\n\n    b = n - i\n\n    if math.gcd(a, b) != 1:\n\n        continue\n\n    if a / b > max_value:\n\n        max_value = a / b\n\n        a1 = a\n\n        b1 = b\n\nprint(a1, b1)",
