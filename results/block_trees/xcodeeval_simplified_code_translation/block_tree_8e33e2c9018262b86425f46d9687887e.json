    "code": " def compute_f_values(limit):\n\n    f = [0] * limit\n\n    for n in range(1, limit):\n\n        f[n] = 2 ** (n - 1) + 2 * f[n - 1]\n\n    return f\n\nf_values = compute_f_values(60)\n\nn = int(input())\n\nans = 0\n\nfor k in range(59, -1, -1):\n\n    if n >= 2**k:\n\n        ans += f_values[k]\n\n        n -= 2**k\n\n        if n > 0:\n\n            ans += 2**k\n\nprint(ans)",
