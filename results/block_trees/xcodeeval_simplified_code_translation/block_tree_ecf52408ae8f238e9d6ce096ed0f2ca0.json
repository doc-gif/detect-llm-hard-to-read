    "code": " __author__ = \"MoonBall\"\n\nimport sys\n\nT = 1\n\nMOD = 1000000007\n\ndef process():\n\n    P, K = map(int, input().split())\n\n    k = [(K * x) % P for x in range(P)]\n\n    if K == 0:\n\n        print(pow(P, P - 1, MOD))\n\n        return\n\n    visited = [0] * P\n\n    cycle_len_count = [0] * P\n\n    result = 1\n\n    for start in range(P):\n\n        if visited[start]:\n\n            continue\n\n        length = 1\n\n        current = start\n\n        visited[current] = 1\n\n        while not visited[k[current]]:\n\n            current = k[current]\n\n            visited[current] = 1\n\n            length += 1\n\n        cycle_len_count[length] += 1\n\n    for length in range(1, P):\n\n        count = cycle_len_count[length]\n\n        if count == 0:\n\n            continue\n\n        total = length * count + (cycle_len_count[1] if length > 1 else 0)\n\n        result = result * pow(total, count, MOD) % MOD\n\n    print(result)\n\nfor _ in range(T):\n\n    process()",
