    "code": " def lucky(x):\n\n    s = str(x)\n\n    return s.count(\"4\") + s.count(\"7\") == len(s)\n\ndef Gen_lucky(n):\n\n    if len(n) == 1:\n\n        if n < \"4\":\n\n            return 0\n\n        if n < \"7\":\n\n            return 1\n\n        return 2\n\n    s = str(n)\n\n    if s[0] < \"4\":\n\n        return 0\n\n    if s[0] == \"4\":\n\n        return Gen_lucky(s[1:])\n\n    if s[0] < \"7\":\n\n        return 2 ** (len(s) - 1)\n\n    if s[0] == \"7\":\n\n        return 2 ** (len(s) - 1) + Gen_lucky(s[1:])\n\n    else:\n\n        return 2 ** len(s)\n\ndef Form(X, k):\n\n    if k == 0:\n\n        return X\n\n    for i in range(len(X)):\n\n        if k >= F[len(X) - i - 1]:\n\n            h = k // F[len(X) - i - 1]\n\n            r = k % F[len(X) - i - 1]\n\n            G = list(X[i + 1 :])\n\n            G.remove(X[i + h])\n\n            G = [X[i]] + G\n\n            return Form(X[:i] + [X[i + h]] + G, r)\n\nF = [1]\n\np = 1\n\ni = 1\n\nwhile p <= 10**15:\n\n    p *= i\n\n    F.append(p)\n\n    i += 1\n\nn, k = map(int, input().split())\n\nif n <= 14:\n\n    if k > F[n]:\n\n        print(-1)\n\n    else:\n\n        permutation = Form(list(range(1, n + 1)), k - 1)\n\n        count = 0\n\n        for i in range(n):\n\n            if lucky(i + 1) and lucky(permutation[i]):\n\n                count += 1\n\n        print(count)\n\nelse:\n\n    permutation = Form(list(range(n - 14, n + 1)), k - 1)\n\n    prefix_str = str(n - 15)\n\n    count = 0\n\n    for i in range(1, len(prefix_str)):\n\n        count += 2**i\n\n    count += Gen_lucky(prefix_str)\n\n    for i in range(n - 14, n + 1):\n\n        if lucky(permutation[i - n + 14]) and lucky(i):\n\n            count += 1\n\n    print(count)",
    "block_tree": {
      "block_code": " def lucky(x):\n    s = str(x)\n    return s.count(\"4\") + s.count(\"7\") == len(s)\ndef Gen_lucky(n):\n    if len(n) == 1:\n        if n < \"4\":\n            return 0\n        if n < \"7\":\n            return 1\n        return 2\n    s = str(n)\n    if s[0] < \"4\":\n        return 0\n    if s[0] == \"4\":\n        return Gen_lucky(s[1:])\n    if s[0] < \"7\":\n        return 2 ** (len(s) - 1)\n    if s[0] == \"7\":\n        return 2 ** (len(s) - 1) + Gen_lucky(s[1:])\n    else:\n        return 2 ** len(s)\ndef Form(X, k):\n    if k == 0:\n        return X\n    for i in range(len(X)):\n        if k >= F[len(X) - i - 1]:\n            h = k // F[len(X) - i - 1]\n            r = k % F[len(X) - i - 1]\n            G = list(X[i + 1 :])\n            G.remove(X[i + h])\n            G = [X[i]] + G\n            return Form(X[:i] + [X[i + h]] + G, r)\nF = [1]\np = 1\ni = 1\nwhile p <= 10**15:\n    p *= i\n    F.append(p)\n    i += 1\nn, k = map(int, input().split())\nif n <= 14:\n    if k > F[n]:\n        print(-1)\n    else:\n        permutation = Form(list(range(1, n + 1)), k - 1)\n        count = 0\n        for i in range(n):\n            if lucky(i + 1) and lucky(permutation[i]):\n                count += 1\n        print(count)\nelse:\n    permutation = Form(list(range(n - 14, n + 1)), k - 1)\n    prefix_str = str(n - 15)\n    count = 0\n    for i in range(1, len(prefix_str)):\n        count += 2**i\n    count += Gen_lucky(prefix_str)\n    for i in range(n - 14, n + 1):\n        if lucky(permutation[i - n + 14]) and lucky(i):\n            count += 1\n    print(count)",
