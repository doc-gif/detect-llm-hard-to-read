    "code": " def gcd(a, b):\n\n    while b > 0:\n\n        a, b = b, a % b\n\n    return a\n\ndef lcm(a, b):\n\n    return int(a * b / gcd(a, b))\n\ndef run(n, crush):\n\n    visited = [False] * n\n\n    cycle_size = 1\n\n    for i in range(n):\n\n        if visited[i]:\n\n            continue\n\n        x = i\n\n        length = 0\n\n        while not visited[x]:\n\n            visited[x] = True\n\n            x = crush[x] - 1\n\n            length += 1\n\n        if x != i:\n\n            return -1\n\n        if length % 2 == 0:\n\n            length //= 2\n\n        cycle_size = lcm(cycle_size, length)\n\n    return cycle_size\n\nn = int(input())\n\ncrush = [int(x) for x in input().split()]\n\nprint(run(n, crush))",
