    "code": " import math\n\ndata = input().split()\n\nN, K = int(data[0]), int(data[1])\n\nif K <= math.ceil(N / 2):\n\n    print(K + (K - 1))\n\nelse:\n\n    if K == N and K % 2 != 0:\n\n        print(K - 1)\n\n    elif (N % 2 != 0 and K % 2 == 0) or (N % 2 != 0 and K % 2 != 0):\n\n        print((K - (N - K)) - 1)\n\n    else:\n\n        print(K - (N - K))",
