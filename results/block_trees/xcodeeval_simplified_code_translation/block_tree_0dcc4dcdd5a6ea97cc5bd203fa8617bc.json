    "code": " dp = {}\n\ndef solve(x):\n\n    if x == 0:\n\n        return 0\n\n    if x in dp:\n\n        return dp[x]\n\n    limit = 1\n\n    cnt = 1\n\n    while limit <= x:\n\n        limit = limit * 10 + 1\n\n        cnt += 1\n\n    prv = limit // 10\n\n    c1 = solve(x % prv) + (x // prv) * (cnt - 1)\n\n    c2 = solve((limit - x) % prv) + cnt + (cnt - 1) * ((limit - x) // prv)\n\n    dp[x] = min(c1, c2)\n\n    return dp[x]\n\nn = int(input())\n\nprint(solve(n))",
