    "code": " from math import factorial\n\ndp = [[-1] * 101 for _ in range(101)]\n\ndef solve(n, p, a):\n\n    if dp[n][p] != -1:\n\n        return dp[n][p]\n\n    if p == 9:\n\n        dp[n][p] = 1 if n >= a[9] else 0\n\n        return dp[n][p]\n\n    if p == 0:\n\n        ans = 0\n\n        for i in range(a[0], n):\n\n            z = solve(n - i, 1, a)\n\n            z *= factorial(n - 1)\n\n            z //= factorial(i)\n\n            z //= factorial(n - 1 - i)\n\n            ans += z\n\n        dp[n][p] = ans\n\n        return ans\n\n    ans = 0\n\n    for i in range(a[p], n + 1):\n\n        z = solve(n - i, p + 1, a)\n\n        z *= factorial(n)\n\n        z //= factorial(i)\n\n        z //= factorial(n - i)\n\n        ans += z\n\n    dp[n][p] = ans\n\n    return ans\n\nMOD = 1000000007\n\nn = int(input())\n\na = list(map(int, input().split()))\n\nans = 0\n\nfor i in range(1, n + 1):\n\n    ans += solve(i, 0, a)\n\n    ans %= MOD\n\nprint(ans)",
