    "code": " def yoba(a, k):\n\n    if not a:\n\n        return []\n\n    if not k:\n\n        return a\n\n    m = max(a[: k + 1])\n\n    mi = a.index(m)\n\n    if m > a[0]:\n\n        a[1 : mi + 1] = a[:mi]\n\n        a[0] = m\n\n        k -= mi\n\n    return [a[0]] + yoba(a[1:], k)\n\na, k = input().split()\n\nk = int(k)\n\nprint(\"\".join(yoba(list(a), k)))",
