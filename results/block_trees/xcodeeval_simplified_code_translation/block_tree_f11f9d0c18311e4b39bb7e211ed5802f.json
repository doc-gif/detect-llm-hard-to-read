    "code": " def main(n, lst):\n\n    if n == 1:\n\n        return \"YES\"\n\n    if lst[0] < lst[1]:\n\n        status = 0\n\n    elif lst[0] == lst[1]:\n\n        status = 1\n\n    else:\n\n        status = 2\n\n    for i in range(len(lst) - 1):\n\n        if status == 0:\n\n            if lst[i] == lst[i + 1]:\n\n                status += 1\n\n            if lst[i] > lst[i + 1]:\n\n                status += 2\n\n        if status == 1:\n\n            if lst[i] > lst[i + 1]:\n\n                status += 1\n\n            if lst[i] < lst[i + 1]:\n\n                return \"NO\"\n\n        if status == 2:\n\n            if lst[i] > lst[i + 1]:\n\n                pass\n\n            else:\n\n                return \"NO\"\n\n    return \"YES\"\n\nn = eval(input())\n\nlst = [eval(i) for i in input().split()]\n\nprint(main(n, lst))",
