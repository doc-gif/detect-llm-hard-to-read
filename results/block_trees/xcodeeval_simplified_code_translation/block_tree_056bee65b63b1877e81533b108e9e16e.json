    "code": " mod = 1000000007\n\ndef power(base, exponent):\n\n    result = 1\n\n    while exponent > 0:\n\n        if exponent % 2 == 1:\n\n            result = (result * base) % mod\n\n        base = (base * base) % mod\n\n        exponent //= 2\n\n    return result\n\nn, m = map(int, input().split())\n\nn += 1\n\nres = power(n * 2, m - 1) * (n - m) * 2\n\nprint(res % mod)",
