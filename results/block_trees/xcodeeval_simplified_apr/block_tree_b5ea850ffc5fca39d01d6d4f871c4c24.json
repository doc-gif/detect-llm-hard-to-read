    "code": " p = 10**9 + 7\n\nimport math\n\n\n\n\n\ndef inv(k, p):\n\n    prod = 1\n\n    while k > 1:\n\n        prod *= p // k + 1\n\n        k = (k * (p // k + 1)) % p\n\n    return prod % p\n\n\n\n\n\nn = int(input())\n\nk = int(math.log2(n))\n\na = []\n\nx = n\n\nwhile x > 0:\n\n    y = x // 2\n\n    a.append(x - y)\n\n    x = y\n\nc = [sum(a[i:]) for i in range(k + 1)]\n\nb = [n // (3 << i) - n // (6 << i) for i in range(k + 1)]\n\nd = [n >> i - n // (3 << i) for i in range(k + 1)]\n\nfacs = [1] * (n + 1)\n\nfor i in range(2, n + 1):\n\n    facs[i] = (i * facs[i - 1]) % p\n\nif n < 3 * (1 << (k - 1)):\n\n    start = k\n\nelse:\n\n    start = 0\n\ntotal = 0\n\nfor j in range(start, k + 1):\n\n    prod = 1\n\n    for i in range(j, k):\n\n        prod *= b[i]\n\n    prod *= d[j]\n\n    for i in range(j):\n\n        prod *= a[i]\n\n    prod %= p\n\n    prod = (prod * facs[n]) % p\n\n    e = a[:j] + [d[j]] + b[j:k]\n\n    f = [sum(e[: i + 1]) for i in range(k + 1)]\n\n    g = 1\n\n    for val in f:\n\n        g *= val\n\n    prod = (prod * inv(g, p)) % p\n\n    total = (total + prod) % p\n\nprint(total)\n",
