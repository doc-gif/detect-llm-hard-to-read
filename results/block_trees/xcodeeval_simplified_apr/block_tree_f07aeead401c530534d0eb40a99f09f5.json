    "code": " l = [int(e) for e in input().strip()]\n\n\n\n\n\ndef lei00(lst):\n\n    result = []\n\n    for i in range(len(lst) - 1, -1, -1):\n\n        if lst[i] == 0:\n\n            result.append(i)\n\n        if len(result) == 2:\n\n            break\n\n    if len(result) < 2:\n\n        return None\n\n    return 2 * len(lst) - result[0] - result[1] - 3\n\n\n\n\n\ndef lei(lst, x, y):\n\n    assert x != y\n\n    ix = None\n\n    iy = None\n\n    for i in range(len(lst) - 1, -1, -1):\n\n        if lst[i] == x:\n\n            ix = i\n\n        elif lst[i] == y:\n\n            iy = i\n\n        if ix is not None and iy is not None:\n\n            break\n\n    if ix is None or iy is None:\n\n        return None\n\n    result = 2 * len(lst) - ix - iy - 3\n\n    if ix > iy:\n\n        result += 1\n\n    if x == 7 or x == 2:\n\n        assert y == 5\n\n        if iy == 0 and lst[1] == 0:\n\n            if len(lst) >= 4:\n\n                iii = 1\n\n                while True:\n\n                    iii += 1\n\n                    if lst[iii] != 0:\n\n                        break\n\n                result += iii - 1\n\n            if len(lst) == 3:\n\n                return None\n\n    return result\n\n\n\n\n\ncandidates = [lei00(l), lei(l, 5, 0), lei(l, 7, 5), lei(l, 2, 5)]\n\nresult = None\n\nfor e in candidates:\n\n    if e is None:\n\n        continue\n\n    if result is None or result > e:\n\n        result = e\n\nif result is None:\n\n    print(-1)\n\nelse:\n\n    print(result)\n",
