    "code": " import sys\n\nimport math\n\nimport collections\n\n\n\nM = 10**9 + 7\n\n\n\n\n\ndef solve():\n\n    n, k = map(int, input().split())\n\n    factor = 2**k\n\n    ans = 1\n\n    for i in range(n):\n\n        ans = (ans * factor) % M\n\n    return (ans * 2) % M\n\n\n\n\n\ntest = int(input())\n\ncount1 = 1\n\nwhile count1 <= test:\n\n    ans = solve()\n\n    sys.stdout.write(str(ans) + \"\\n\")\n\n    count1 += 1\n",
