    "code": " n, k = map(int, input().split())\n\ns = input()\n\nmax_n_len = 0\n\nleft = 0\n\nwhile left < n:\n\n    if s[left] != \"N\":\n\n        left += 1\n\n    else:\n\n        right = left + 1\n\n        while right < n and s[right] == \"N\":\n\n            right += 1\n\n        max_n_len = max(max_n_len, right - left)\n\n        left = right\n\nif max_n_len > k:\n\n    print(\"NO\")\n\n    exit(0)\n\nans = \"NO\"\n\nfor start in range(n):\n\n    can = 1\n\n    if start + k < n and s[start + k] == \"N\":\n\n        can = 0\n\n    if start == 0 or s[start - 1] != \"N\":\n\n        if start + k <= n:\n\n            for i in range(k):\n\n                if s[start + i] == \"Y\":\n\n                    can = 0\n\n    else:\n\n        can = 0\n\n    if can == 1:\n\n        ans = \"YES\"\n\nprint(ans)\n",
