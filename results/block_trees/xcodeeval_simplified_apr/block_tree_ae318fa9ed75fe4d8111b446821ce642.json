    "code": " def exgcd(a, b):\n\n    if b == 0:\n\n        return (a, 1, 0)\n\n    g, y, x = exgcd(b, a % b)\n\n    return (g, x, y - x * (a // b))\n\n\n\n\n\ndef crt(a1, m1, a2, m2):\n\n    g = exgcd(m1, m2)[0]\n\n    e1, e2 = a1 % g, a2 % g\n\n    if e1 != e2:\n\n        return None\n\n    a1 //= g\n\n    m1 //= g\n\n    a2 //= g\n\n    m2 //= g\n\n    _, m1i, m2i = exgcd(m1, m2)\n\n    ans = a1 * m2 * m2i + a2 * m1 * m1i\n\n    ans %= m1 * m2\n\n    if ans < 0:\n\n        ans += m1 * m2\n\n    return ans * g + e1\n\n\n\n\n\ndef solve(N, M, x, y, vx, vy):\n\n    if vx == 0:\n\n        return (x, 0) if x == 0 or x == N else None\n\n    if vy == 0:\n\n        return (y, 0) if y == 0 or y == M else None\n\n    ans = crt(x, N, y, M)\n\n    if ans is None:\n\n        return None\n\n    xhit = (ans + N - 1) // N\n\n    yhit = (ans + M - 1) // M\n\n    if x == 0:\n\n        xhit -= 1\n\n    if y == 0:\n\n        yhit -= 1\n\n    final_x = 0 if xhit % 2 else N\n\n    final_y = 0 if yhit % 2 else M\n\n    return (final_x, final_y)\n\n\n\n\n\ndef main():\n\n    N, M, x, y, vx, vy = map(int, input().split())\n\n    swapx = vx > 0\n\n    swapy = vy > 0\n\n    if swapx:\n\n        x = N - x\n\n    if swapy:\n\n        y = M - y\n\n    ans = solve(N, M, x, y, vx, vy)\n\n    if ans is None:\n\n        print(-1)\n\n    else:\n\n        ax, ay = ans\n\n        if swapx:\n\n            ax = N - ax\n\n        if swapy:\n\n            ay = M - ay\n\n        print(ax, ay)\n\n\n\n\n\nif __name__ == \"__main__\":\n\n    main()\n",
