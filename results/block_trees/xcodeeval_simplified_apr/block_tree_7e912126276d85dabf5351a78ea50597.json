    "code": " import sys\n\n\n\nrange = xrange\n\ninput = raw_input\n\nMOD = 10**9 + 7\n\n\n\n\n\ndef matrix_multiply(A, B):\n\n    n = len(A)\n\n    C = [[0] * n for _ in range(n)]\n\n    for x in range(n):\n\n        for y in range(n):\n\n            for z in range(n):\n\n                C[x][y] += A[z][y] * B[x][z]\n\n            C[x][y] %= MOD\n\n    return C\n\n\n\n\n\ndef matrix_vector_multiply(A, v):\n\n    n = len(A)\n\n    result = [0] * n\n\n    for y in range(n):\n\n        result[y] = sum(A[x][y] * v[x] for x in range(n)) % MOD\n\n    return result\n\n\n\n\n\nn, m = map(int, input().split())\n\nmapper = [[0] * m for _ in range(m)]\n\nmapper[0][0] = 1\n\nmapper[-1][0] = 1\n\nfor i in range(m - 1):\n\n    mapper[i][i + 1] = 1\n\n\n\n\n\ndef power_matrix_vector(A, v, exponent):\n\n    if exponent == 0:\n\n        return v\n\n    while exponent > 1:\n\n        if exponent % 2 == 1:\n\n            v = matrix_vector_multiply(A, v)\n\n        A = matrix_multiply(A, A)\n\n        exponent //= 2\n\n    return matrix_vector_multiply(A, v)\n\n\n\n\n\ninitial_vector = [1] * m\n\nresult_vector = power_matrix_vector(mapper, initial_vector, n)\n\nprint(result_vector[-1] % MOD)\n",
