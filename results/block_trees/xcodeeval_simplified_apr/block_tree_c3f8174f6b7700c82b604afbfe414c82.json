    "code": " import sys\n\n\n\ninput = lambda: sys.stdin.readline().rstrip()\n\nT = int(input())\n\n\n\n\n\ndef dfs(keys, depth, remaining_value, remaining_count):\n\n    if depth == len(keys):\n\n        return False\n\n    key = keys[depth]\n\n    for c in range(remaining_count + 1):\n\n        new_value = remaining_value - key * c\n\n        if new_value < 0:\n\n            return False\n\n        elif new_value == 0 and remaining_count - c == 0:\n\n            return True\n\n        else:\n\n            if depth == len(keys):\n\n                return False\n\n            else:\n\n                if dfs(keys, depth + 1, new_value, remaining_count - c):\n\n                    return True\n\n\n\n\n\nfor _ in range(T):\n\n    n, m, k = map(int, input().split())\n\n    if n % 2 == 0 and m % 2 == 0:\n\n        print(\"YES\" if k % 2 == 0 else \"NO\")\n\n    else:\n\n        if m % 2 == 0:\n\n            n, m = m, n\n\n        else:\n\n            k = (n * m) // 2 - k\n\n        keys = list(range(1, m + 1, 2))\n\n        if dfs(keys, 0, k, n // 2):\n\n            print(\"YES\")\n\n        else:\n\n            print(\"NO\")\n",
