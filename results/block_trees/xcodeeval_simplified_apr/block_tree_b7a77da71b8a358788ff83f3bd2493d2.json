    "code": " import sys\n\nimport itertools\n\nfrom collections import defaultdict\n\n\n\nfactorials = [1] * 19\n\nfor i in range(1, 19):\n\n    factorials[i] = i * factorials[i - 1]\n\n\n\n\n\ndef cumsum(l):\n\n    for i in range(1, len(l)):\n\n        l[i] += l[i - 1]\n\n\n\n\n\ndef enum(lst):\n\n    global K, S\n\n    d = defaultdict(lambda: [0] * (K + 1))\n\n    for opts in itertools.product((0, 1, 2), repeat=len(lst)):\n\n        s = 0\n\n        marks = 0\n\n        for i, opt in enumerate(opts):\n\n            if s > S:\n\n                break\n\n            if opt == 1:\n\n                s += lst[i]\n\n            elif opt == 2:\n\n                if lst[i] <= 18:\n\n                    s += factorials[lst[i]]\n\n                    marks += 1\n\n                else:\n\n                    s = S + 1\n\n        if s <= S:\n\n            d[s][marks] += 1\n\n    return d\n\n\n\n\n\nn, K, S = map(int, sys.stdin.next().split())\n\nl = sorted(map(int, sys.stdin.next().split()))\n\nmid = len(l) // 2\n\np1 = enum(l[:mid][::-1])\n\np2 = enum(l[mid:][::-1])\n\nvariants = 0\n\nfor s in p1:\n\n    target = S - s\n\n    if target in p2:\n\n        m1 = p1[s]\n\n        m2 = p2[target]\n\n        for k1, c1 in enumerate(m1):\n\n            for k2, c2 in enumerate(m2):\n\n                if k1 + k2 <= K:\n\n                    variants += c1 * c2\n\nprint(variants)\n",
