    "code": " import sys\n\n\n\nMOD = 10**9 + 7\n\n\n\n\n\ndef main():\n\n    n = int(sys.stdin.readline().strip())\n\n    t = 1\n\n    m = 1\n\n    for i in range(1, n + 2):\n\n        t = (t * ((n + i + 1) % MOD)) % MOD\n\n        m = (m * (i % MOD)) % MOD\n\n    print((t // m - 1) % MOD)\n\n\n\n\n\nif __name__ == \"__main__\":\n\n    main()\n",
