    "code": " def prime(n):\n\n    i = 2\n\n    while i * i <= n:\n\n        if n % i == 0:\n\n            return 0\n\n        i += 1\n\n    return 1\n\n\n\n\n\ndef binpow(x, y, mod):\n\n    if y == 0:\n\n        return 1\n\n    if y == -1:\n\n        return 1.0 / x\n\n    p = binpow(x, y // 2, mod)\n\n    p *= p\n\n    if y % 2:\n\n        p *= x\n\n    return p % mod\n\n\n\n\n\nMOD = 998244353\n\nn, m = map(int, input().split())\n\ntotal = 0\n\nfor i in range(1, n + 1):\n\n    total += pow(m, i, MOD)\n\ncnt = 1\n\nsubtract_term = 1\n\nfor i in range(1, n + 1):\n\n    if cnt > m:\n\n        break\n\n    if prime(i):\n\n        cnt *= i\n\n    subtract_term = (subtract_term * (m // cnt)) % MOD\n\n    total -= subtract_term\n\nprint(total)\n",
