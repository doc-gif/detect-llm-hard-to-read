    "code": " def cifreDuzina(x):\n\n    cifre = {-1}\n\n    br = 0\n\n    while x:\n\n        tmp = x % 10\n\n        cifre.add(tmp)\n\n        x //= 10\n\n        br += 1\n\n    cifre.remove(-1)\n\n    return [cifre, br]\n\n\n\n\n\ndef resi():\n\n    n, x = map(int, input().split())\n\n    l = najvecaCifra(x)\n\n    br = 0\n\n    while l[1] < n:\n\n        if l[0] == 1:\n\n            print(-1)\n\n            return\n\n        x *= l[0]\n\n        br += 1\n\n        l = najvecaCifra(x)\n\n    print(br)\n\n\n\n\n\ndef rekurzija(n, x):\n\n    if cifreDuzina(x)[1] == n:\n\n        return 0\n\n    else:\n\n        mn = 100000\n\n        for c in cifreDuzina(x)[0]:\n\n            if c == 0 or c == 1:\n\n                continue\n\n            if mn > rekurzija(n, c * x):\n\n                mn = rekurzija(n, c * x)\n\n        return mn + 1\n\n\n\n\n\nn, x = map(int, input().split())\n\nresult = rekurzija(n, x)\n\nif result != 100001:\n\n    print(result)\n\nelse:\n\n    print(-1)\n",
