    "code": " read = lambda: map(int, input().split())\n\nn, v, e = read()\n\nadj = [[] for _ in range(n + 1)]\n\nAs = [0] + list(read())\n\nBs = [0] + list(read())\n\nans = []\n\nfor _ in range(e):\n\n    a, b = map(int, input().split())\n\n    adj[a].append(b)\n\n    adj[b].append(a)\n\n\n\n\n\ndef flow(a, b, d):\n\n    As[a] -= d\n\n    As[b] += d\n\n    ans.append((a, b, d))\n\n\n\n\n\ndef augment(path, e, d):\n\n    if e:\n\n        dd = min(d, As[path[e - 1]], v - As[path[e]])\n\n        flow(path[e - 1], path[e], dd)\n\n        augment(path, e - 1, d)\n\n        if d > dd:\n\n            flow(path[e - 1], path[e], d - dd)\n\n\n\n\n\ndef adjust(s):\n\n    pre = [0] * (n + 1)\n\n    pre[s] = -1\n\n    stack = [s]\n\n    e = 0\n\n    while stack:\n\n        p = stack.pop()\n\n        if As[p] < Bs[p]:\n\n            e = p\n\n            break\n\n        for to in adj[p]:\n\n            if not pre[to]:\n\n                pre[to] = p\n\n                stack.append(to)\n\n    if not e:\n\n        raise Exception\n\n    path = []\n\n    while e > 0:\n\n        path.insert(0, e)\n\n        e = pre[e]\n\n    augment(path, len(path) - 1, min(Bs[path[-1]] - As[path[-1]], As[s] - Bs[s]))\n\n\n\n\n\ntry:\n\n    while True:\n\n        check = False\n\n        for i in range(1, n + 1):\n\n            if As[i] > Bs[i]:\n\n                adjust(i)\n\n                check = True\n\n        if not check:\n\n            break\n\n    for i in range(1, n + 1):\n\n        if As[i] != Bs[i]:\n\n            raise Exception\n\n    print(len(ans))\n\n    for tp in ans:\n\n        print(*tp)\n\nexcept Exception:\n\n    print(\"NO\")\n",
