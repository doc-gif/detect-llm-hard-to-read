    "code": " def divi(n):\n\n    if n == 0:\n\n        return 0\n\n    elif n == 1:\n\n        return n\n\n    elif n == 11:\n\n        return 2\n\n    elif n % 11 <= 6:\n\n        k = n % 11\n\n        count = 0\n\n        for _ in range(n):\n\n            count += 1\n\n        return count\n\n    else:\n\n        k = n % 11\n\n        h = 11\n\n        count = 2\n\n        while h > n:\n\n            h -= 1\n\n            count += 1\n\n        return count\n\n\n\n\n\ndef divide_maior(n):\n\n    divisao = n // 11\n\n    resto = n % 11\n\n    valor_menor_que_onze = divi(resto)\n\n    valor_maior_que_onze = divisao * 2\n\n    return valor_maior_que_onze + valor_menor_que_onze\n\n\n\n\n\ndef execute():\n\n    n = int(input())\n\n    m = divide_maior(n)\n\n    print(m)\n\n\n\n\n\nexecute()\n",
