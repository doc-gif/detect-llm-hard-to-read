    "code": " n, m = map(int, input().split())\n\nans = 0\n\nfact = [1] * (n + 1)\n\nfor i in range(1, n + 1):\n\n    fact[i] = fact[i - 1] * i\n\nfor d in range(1, n):\n\n    s = n - d\n\n    t = fact[d + 1] * fact[n - d - 1] * s * (n - d)\n\n    ans = (ans + t) % m\n\ntemp = fact[n] * n\n\nans = (ans + temp) % m\n\nprint(ans)\n",
